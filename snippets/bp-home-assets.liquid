  #bp-compare .cx-board-head{ min-height:78px; }
  #bp-compare .cx-corner,#bp-compare .cx-brand,#bp-compare .cx-label,#bp-compare .cx-value{ display:flex; align-items:center; }
  #bp-compare .cx-corner{ padding:18px 20px; background:#E9E3D6; color:#776A59; font-family:var(--brand-font-display); font-size:10px; line-height:1.25; letter-spacing:.08em; text-transform:uppercase; }
  #bp-compare .cx-brand{ padding:18px 22px; font-family:var(--brand-font-title); font-size:clamp(19px,1.8vw,25px); font-weight:800; }
