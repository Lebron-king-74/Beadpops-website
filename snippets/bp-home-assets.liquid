  /* Ajustements de parcours : niveaux, etapes et raisons */
  #bp-modes .md-grid{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:clamp(12px,1.4vw,20px);
    border-top:0;
  }
  #bp-modes .md-card{
    min-width:0;
    height:100%;
    grid-template-columns:48px minmax(0,1fr);
    grid-template-areas:"num copy" "media media" "cta cta";
    grid-template-rows:auto auto auto;
    align-content:start;
    gap:16px 12px;
    padding:18px;
    border:1px solid color-mix(in srgb,#F5EDE0 16%,transparent);
    border-radius:6px;
    background:#161412;
  }
  #bp-modes .md-card::before{ display:none; }
  #bp-modes .md-top{ align-self:start; padding-top:3px; }
  #bp-modes .md-copy{ align-self:start; }
  #bp-modes .md-badge{ margin-bottom:7px; }
  #bp-modes .md-name{ margin-bottom:6px; }
