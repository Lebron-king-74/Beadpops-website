/* Onglets univers : tablist accessible (clic + flèches clavier) */
(function(){
  const tablist = document.querySelector('#bp-universe .uv-tabs');
  if(!tablist) return;
  const tabs = Array.from(tablist.querySelectorAll('.uv-tab'));
  function select(tab, focus){
    tabs.forEach(t=>{
      const on = t===tab;
      t.setAttribute('aria-selected', on?'true':'false');
      t.tabIndex = on?0:-1;
      const panel = document.getElementById(t.getAttribute('aria-controls'));
      if(panel){ panel.hidden = !on; panel.classList.toggle('is-active', on); }
    });
    if(matchMedia('(max-width:680px)').matches){ tab.scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'}); }
    if(focus) tab.focus();
  }
  tablist.addEventListener('click', e=>{ const t=e.target.closest('.uv-tab'); if(t) select(t,false); });
  tablist.addEventListener('keydown', e=>{
    const i = tabs.indexOf(document.activeElement);
    if(i<0) return;
    let n=-1;
    if(e.key==='ArrowRight'||e.key==='ArrowDown') n=(i+1)%tabs.length;
    else if(e.key==='ArrowLeft'||e.key==='ArrowUp') n=(i-1+tabs.length)%tabs.length;
    else if(e.key==='Home') n=0;
    else if(e.key==='End') n=tabs.length-1;
    if(n>=0){ e.preventDefault(); select(tabs[n],true); }
  });

  /* Flèches carousel : scroll horizontal du viewport */
  document.querySelectorAll('#bp-universe .uv-carousel').forEach(car=>{
    const vp = car.querySelector('.uv-viewport');
    if(!vp) return;
    car.querySelectorAll('.uv-arrow').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        const dir = btn.classList.contains('prev') ? -1 : 1;
        vp.scrollBy({ left: dir * vp.clientWidth * 0.85, behavior:'smooth' });
      });
    });
  });

  /* Toggle favoris (cœur) */
  document.querySelectorAll('#bp-universe .uv-heart').forEach(h=>{
    h.addEventListener('click', e=>{
      e.preventDefault();
      const on = h.getAttribute('aria-pressed')==='true';
      h.setAttribute('aria-pressed', on?'false':'true');
      h.classList.toggle('is-liked', !on);
    });
  });
})();

/* Comment ça marche : la fabrication avance avec le scroll */
(function(){
  var section=document.querySelector('#bp-how[data-scroll-story]');
  if(!section) return;
  var stage=section.querySelector('.hw-stage');
  var processSprite=section.querySelector('.hw-sprite--process');
  var resultSprite=section.querySelector('.hw-sprite--result');
  var steps=Array.from(section.querySelectorAll('.hw-step'));
  var stageStep=section.querySelector('.hw-stage-step');
  var liveCaption=section.querySelector('.hw-live-caption');
  var liveStep=section.querySelector('.hw-live-step');
  var liveName=section.querySelector('.hw-live-name');
  var liveDesc=section.querySelector('.hw-live-desc');
  var reduced=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var visible=true;
  var queued=false;
  var liveIndex=-1;
  var captionTimer=0;

  function clamp(value,min,max){ return Math.max(min,Math.min(max,value)); }
  function setSpriteFrame(sprite,progress,frameCount,columns,rows){
    if(!sprite) return;
    var frame=Math.round(clamp(progress,0,1)*(frameCount-1));
    var column=frame%columns;
    var row=Math.floor(frame/columns);
    var x=columns>1?column/(columns-1)*100:0;
    var y=rows>1?row/(rows-1)*100:0;
    sprite.style.backgroundPosition=x+'% '+y+'%';
  }
  function setStep(index){
    steps.forEach(function(step,i){ step.classList.toggle('is-active',i===index); });
    var active=steps[index];
    if(!active) return;
    if(stageStep) stageStep.textContent='Étape '+active.dataset.step;
    if(liveCaption && liveIndex!==index){
      liveIndex=index;
      liveCaption.classList.add('is-changing');
      window.clearTimeout(captionTimer);
      captionTimer=window.setTimeout(function(){
        var name=active.querySelector('.hw-name');
        var desc=active.querySelector('.hw-desc');
        if(liveStep) liveStep.textContent='Étape '+String(index+1);
        if(liveName && name) liveName.textContent=name.textContent;
        if(liveDesc && desc) liveDesc.textContent=desc.textContent;
        liveCaption.classList.remove('is-changing');
      },90);
    }
  }
  function update(){
    queued=false;
    if(!visible||reduced) return;
    var focusRatio=window.matchMedia('(max-width:820px)').matches ? .74 : .52;
    var focusY=window.scrollY+window.innerHeight*focusRatio;
    var centers=steps.map(function(step){
      var rect=step.getBoundingClientRect();
      return window.scrollY+rect.top+rect.height/2;
    });
    var processProgress=clamp((focusY-centers[0])/Math.max(1,centers[1]-centers[0]),0,1);
    var reveal=clamp((focusY-centers[1])/Math.max(1,centers[2]-centers[1]),0,1);
    var progress=processProgress<1?processProgress*.5:.5+reveal*.5;
    setSpriteFrame(processSprite,processProgress,29,6,5);
    setSpriteFrame(resultSprite,reveal,7,4,2);
    resultSprite.style.opacity=String(reveal);
    stage.style.setProperty('--hw-progress',String(progress));
    var firstBreak=(centers[0]+centers[1])/2;
    var secondBreak=(centers[1]+centers[2])/2;
    setStep(focusY<firstBreak?0:focusY<secondBreak?1:2);
  }
  function requestUpdate(){
    if(queued) return;
    queued=true;
    requestAnimationFrame(update);
  }
  if(reduced){
    setSpriteFrame(processSprite,1,29,6,5);
    setSpriteFrame(resultSprite,1,7,4,2);
    resultSprite.style.opacity='1';
    setStep(2);
    return;
  }
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(entries){
      entries.forEach(function(entry){ visible=entry.isIntersecting; if(visible) requestUpdate(); });
    },{rootMargin:'25% 0px 25% 0px'}).observe(section);
  }
  window.addEventListener('scroll',requestUpdate,{passive:true});
  window.addEventListener('resize',requestUpdate,{passive:true});
  document.addEventListener('visibilitychange',function(){ visible=!document.hidden; if(visible) requestUpdate(); });
  requestUpdate();
})();

/* Mouvement progressif : rythme de pose, listes et continuité de lecture */
(function(){
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduced || !('IntersectionObserver' in window)) return;
  var heads = document.querySelectorAll('#bp-universe .uv-head,#bp-modes .md-head,#bp-how .hw-head,#bp-offer .offer-head,#bp-reasons .rs-head,#bp-create .cr-head,#bp-reviews .rv-head,#bp-forwho .fw-head,#bp-compare .cx-head,#bp-gallery .gal-head');
  var groups = [
    document.querySelectorAll('#bp-modes .md-card'),
    document.querySelectorAll('#bp-forwho .fw-card'),
    document.querySelectorAll('#bp-compare .cx-row')
  ];
  heads.forEach(function(el){ el.classList.add('bp-motion'); });
  groups.forEach(function(nodes){
    nodes.forEach(function(el,index){
      el.classList.add('bp-motion');
      el.style.setProperty('--motion-delay',Math.min(index * 55,220) + 'ms');
    });
  });
  document.documentElement.classList.add('motion-ready');
  var observer = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(!entry.isIntersecting) return;
      entry.target.classList.add('is-visible');
      observer.unobserve(entry.target);
    });
  },{threshold:.12,rootMargin:'0px 0px -7% 0px'});
  document.querySelectorAll('.bp-motion').forEach(function(el){ observer.observe(el); });
  var marquee = document.querySelector('.bp-marquee');
  if(marquee){
    var marqueeObserver = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){ marquee.classList.toggle('is-running',entry.isIntersecting && !document.hidden); });
    },{threshold:.05});
    marqueeObserver.observe(marquee);
    document.addEventListener('visibilitychange',function(){ if(document.hidden){ marquee.classList.remove('is-running'); } });
  }
  var visualLoop = document.getElementById('bp-visual-loop');
  if(visualLoop){
    var visualLoopVisible = false;
    function syncVisualLoop(){ visualLoop.classList.toggle('is-running',visualLoopVisible && !document.hidden); }
    var visualLoopObserver = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){ visualLoopVisible=entry.isIntersecting; syncVisualLoop(); });
    },{threshold:.05});
    visualLoopObserver.observe(visualLoop);
    document.addEventListener('visibilitychange',syncVisualLoop);
  }
})();

/* Videos hero : lecture uniquement quand le hero est visible */
(function(){
  var hero=document.querySelector('#os-hero');
  if(!hero || !('IntersectionObserver' in window)) return;
  var videos=hero.querySelectorAll('video');
  var heroVisible=true;
  function sync(){
    videos.forEach(function(video){
      if(heroVisible && !document.hidden){
        var play=video.play();
        if(play&&play.catch){ play.catch(function(){}); }
      }else{
        video.pause();
      }
    });
  }
  new IntersectionObserver(function(entries){
    heroVisible=entries[0].isIntersecting;
    sync();
  },{threshold:.04}).observe(hero);
  document.addEventListener('visibilitychange',sync);
})();

