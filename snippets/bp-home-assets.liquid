    #bp-reviews .rv-ba{ grid-area:ba; align-self:start; grid-template-columns:1fr 1fr; gap:8px; margin-top:4px; border-top:1px solid color-mix(in srgb,#0C0B0B 8%, transparent); padding-top:12px; }
    #bp-reviews .rv-col-h{ font-family:var(--brand-font-title); font-style:italic; font-weight:800; font-size:13.5px; letter-spacing:0; text-transform:none; margin:0 0 9px; }
    #bp-reviews .rv-before .rv-col-h{ color:#0C0B0B; }
    #bp-reviews .rv-after .rv-col-h{ color:var(--brand-accent); }
    #bp-reviews .rv-ba ul{ gap:6px; }
