<script>
(function(){
  function initializeBeadPops(){
    if(document.documentElement.dataset.beadpopsReady==='true') return;
    document.documentElement.dataset.beadpopsReady='true';
/* Avis clients : piste circulaire pour swipe et fleches sans fin */
(function(){
  var viewport = document.getElementById('rv-viewport');
  var track = document.getElementById('rv-track');
  if(!viewport || !track) return;
  var originals = Array.prototype.slice.call(track.querySelectorAll('.rv-card'));
  var N = originals.length;
  if(!N) return;
  function cloneCard(card){
    var clone=card.cloneNode(true), media=clone.querySelector('img');
    clone.setAttribute('aria-hidden','true');
    if(media) media.setAttribute('loading','eager');
    return clone;
  }
  originals.slice().reverse().forEach(function(card){ track.insertBefore(cloneCard(card),track.firstChild); });
  originals.forEach(function(card){ track.appendChild(cloneCard(card)); });
  var cards = Array.prototype.slice.call(track.querySelectorAll('.rv-card'));
  var M = cards.length;
  var dotsWrap = document.getElementById('rv-dots');
  var idx = N, dots = [], ticking = false, scrollTimer = 0, programmatic = false;
  for(var i=0;i<N;i++){ (function(k){ var d=document.createElement('button'); d.type='button'; d.className='rv-dot'; d.setAttribute('aria-label','Avis '+(k+1)); d.addEventListener('click',function(){ goToReal(k); }); dotsWrap.appendChild(d); dots.push(d); })(i); }
  function logicalIndex(){ return ((idx-N)%N+N)%N; }
  function cardLeft(i){ return cards[i].offsetLeft - (viewport.clientWidth - cards[i].offsetWidth) / 2; }
  function updateActive(){
    var logical=logicalIndex();
    for(var j=0;j<M;j++) cards[j].classList.toggle('is-active',j===idx);
    for(var k=0;k<N;k++){
      dots[k].classList.toggle('is-active',k===logical);
      dots[k].setAttribute('aria-current',k===logical ? 'true' : 'false');
    }
  }
  function sync(){
    var center = viewport.scrollLeft + viewport.clientWidth / 2;
    var nearest = 0, distance = Infinity;
    for(var i=0;i<M;i++){
      var cardCenter = cards[i].offsetLeft + cards[i].offsetWidth / 2;
      var currentDistance = Math.abs(cardCenter - center);
      if(currentDistance < distance){ distance = currentDistance; nearest = i; }
    }
    idx = nearest;
    updateActive();
    ticking = false;
  }
  function place(instant){
    programmatic=true;
    viewport.scrollTo({left:cardLeft(idx),behavior:instant ? 'auto' : 'smooth'});
    updateActive();
    window.setTimeout(function(){ programmatic=false; },instant ? 0 : 420);
  }
  function recenter(){
    if(idx<N){ idx+=N; place(true); }
    else if(idx>=2*N){ idx-=N; place(true); }
  }
  function step(delta){
    recenter();
    idx+=delta;
    place(false);
    window.clearTimeout(scrollTimer);
    scrollTimer=window.setTimeout(recenter,460);
  }
  function goToReal(logical){
    idx=N+logical;
    place(false);
    window.clearTimeout(scrollTimer);
    scrollTimer=window.setTimeout(recenter,460);
  }
  viewport.addEventListener('scroll',function(){
    if(!ticking){ ticking=true; requestAnimationFrame(sync); }
    if(programmatic) return;
    window.clearTimeout(scrollTimer);
    scrollTimer=window.setTimeout(recenter,160);
  },{passive:true});
  var prev = document.querySelector('#bp-reviews .rv-prev'), next = document.querySelector('#bp-reviews .rv-next');
  if(prev) prev.addEventListener('click', function(){ step(-1); });
  if(next) next.addEventListener('click', function(){ step(1); });
  window.addEventListener('resize',function(){ recenter(); place(true); },{passive:true});
  requestAnimationFrame(function(){ place(true); });
})();

/* Raisons : comportements mobile et desktop isoles */
(function(){
  var R = document.querySelectorAll('#bp-reasons .reason');
  if(!R.length) return;
  var section = document.querySelector('#bp-reasons');
  var label = document.querySelector('#bp-reasons .rp-label');
  var frame = document.querySelector('#bp-reasons .rp-frame');
  var mobileQuery = window.matchMedia('(max-width:820px)');
  var mobileMode = mobileQuery.matches;
  var activeReason = null;
  var currentIndex = mobileMode ? -1 : 0;
  var scrollTicking = false;
  var lastScrollY = window.scrollY;
  var lastReasonChange = 0;
  var sectionVisible = false;

  function safePlay(video){
    if(!video) return;
    var play=video.play();
    if(play&&play.catch){ play.catch(function(){}); }
  }
  function pauseInlineVideos(){
    R.forEach(function(reason){
      reason.querySelectorAll('.reason-media video').forEach(function(video){ video.pause(); });
    });
  }
  function playInlineVideo(reason){
    pauseInlineVideos();
    if(!reason || !sectionVisible) return;
    safePlay(reason.querySelector('.reason-media video'));
  }
  function pausePreview(){
    var video=frame&&frame.querySelector('video');
    if(video){ video.pause(); }
  }
  function syncPreview(reason){
    if(!reason || mobileMode || !frame) return;
    var name = reason.querySelector('.reason-name');
    if(label && name){ label.textContent = name.textContent; }
    var imageSource = reason.getAttribute('data-img');
    var videoSource = reason.getAttribute('data-video');
    var image = frame.querySelector('img');
    if(imageSource){
      if(!image){ image=document.createElement('img'); image.alt=''; frame.appendChild(image); }
      image.src=imageSource;
      image.style.display='block';
    }else if(image){
      image.style.display='none';
    }
    var video = frame.querySelector('video');
    if(videoSource){
      if(!video){
        video=document.createElement('video');
        video.muted=true;
        video.loop=true;
        video.playsInline=true;
        video.setAttribute('muted','');
        video.setAttribute('playsinline','');
        video.setAttribute('preload','metadata');
        frame.appendChild(video);
      }
      if(video.getAttribute('src')!==videoSource){ video.src=videoSource; }
      video.style.display='block';
      if(sectionVisible){ safePlay(video); }
    }else if(video){
      video.pause();
      video.style.display='none';
    }
  }
  function closeAll(){
    R.forEach(function(reason){ reason.open=false; });
    activeReason=null;
    pauseInlineVideos();
  }
  function activate(index){
    index=Math.max(0,Math.min(R.length-1,index));
    var reason=R[index];
    if(!reason) return;
    R.forEach(function(other){ if(other!==reason){ other.open=false; } });
    reason.open=true;
    activeReason=reason;
    currentIndex=index;
    if(mobileMode){
      pausePreview();
      playInlineVideo(reason);
    }else{
      pauseInlineVideos();
      syncPreview(reason);
    }
  }
  function nearestReason(){
    var focus=window.innerHeight*(mobileMode ? .56 : .52);
    var best=0;
    var distance=Infinity;
    var center=0;
    R.forEach(function(reason,index){
      var summary=reason.querySelector('.reason-head');
      var rect=(summary||reason).getBoundingClientRect();
      var nextCenter=rect.top+rect.height*.5;
      var nextDistance=Math.abs(nextCenter-focus);
      if(nextDistance<distance){ distance=nextDistance; best=index; center=nextCenter; }
    });
    return {index:best,center:center};
  }
  function syncFromScroll(){
    scrollTicking=false;
    var currentScrollY=window.scrollY;
    var direction=currentScrollY===lastScrollY?0:(currentScrollY>lastScrollY?1:-1);
    lastScrollY=currentScrollY;
    var sectionRect=section.getBoundingClientRect();
    if(sectionRect.bottom<=0 || sectionRect.top>=window.innerHeight) return;
    var nearest=nearestReason();
    var now=performance.now();
    if(mobileMode){
      var inActivationBand=nearest.center>window.innerHeight*.28 && nearest.center<window.innerHeight*.78;
      if(!inActivationBand || direction===0 || now-lastReasonChange<260) return;
      if(currentIndex<0){
        activate(nearest.index);
      }else if(direction>0 && nearest.index>currentIndex){
        activate(currentIndex+1);
      }else if(direction<0 && nearest.index<currentIndex){
        activate(currentIndex-1);
      }else{
        return;
      }
      lastReasonChange=now;
      return;
    }
    if(now-lastReasonChange<220) return;
    if(direction>0 && nearest.index>currentIndex){
      activate(currentIndex+1);
      lastReasonChange=now;
    }else if(direction<0 && nearest.index<currentIndex){
      activate(currentIndex-1);
      lastReasonChange=now;
    }
  }
  function applyMode(force){
    var nextMobile=mobileQuery.matches;
    if(!force && nextMobile===mobileMode) return;
    mobileMode=nextMobile;
    lastScrollY=window.scrollY;
    lastReasonChange=performance.now();
    if(mobileMode){
      currentIndex=-1;
      closeAll();
      pausePreview();
    }else{
      currentIndex=0;
      activate(0);
    }
  }

  R.forEach(function(reason,index){
    var summary=reason.querySelector('summary');
    if(!summary) return;
    summary.addEventListener('click',function(event){
      event.preventDefault();
      if(mobileMode && reason.open){
        reason.open=false;
        activeReason=null;
        currentIndex=-1;
        pauseInlineVideos();
      }else{
        activate(index);
      }
      lastReasonChange=performance.now();
    });
  });

  pauseInlineVideos();
  applyMode(true);
  if(section && 'IntersectionObserver' in window){
    new IntersectionObserver(function(entries){
      sectionVisible=entries[0].isIntersecting;
      if(!sectionVisible){
        pauseInlineVideos();
        pausePreview();
      }else if(mobileMode){
        playInlineVideo(activeReason);
      }else{
        safePlay(frame&&frame.querySelector('video'));
      }
    },{rootMargin:'120px 0px'}).observe(section);
  }
  window.addEventListener('scroll',function(){
    if(scrollTicking) return;
    scrollTicking=true;
    requestAnimationFrame(syncFromScroll);
  },{passive:true});
  window.addEventListener('resize',function(){
    applyMode(false);
  },{passive:true});
})();

