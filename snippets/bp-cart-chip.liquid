{%- comment -%}
  Une "pastille" de couleur dans la grille d'un design déplié (voir main-cart-items.liquid,
  bp-cart-groups) — remplace la ligne de tableau utilisée avant pour une ligne perle. Réutilise tel
  quel le bloc fonctionnel quantité/retrait (mêmes classes/attributs que l'ancienne ligne) : les
  custom elements du thème qui s'y accrochent (<quantity-input>, <cart-remove-button>, le listener
  'change' de <cart-items>) n'ont besoin d'aucun changement, seule la mise en page visuelle autour
  change. `cart-item`/`cart-item__name` gardés en classes additionnelles pour les sélecteurs de
  cart.js qui comptent les lignes affichées ou gèrent le focus après un retrait.

  Simplification assumée pour ce gabarit compact : pas de pastille d'options avancées (règles de
  quantité minimum/palier, tarif dégressif) — les couleurs de perles sont des articles simples à
  prix fixe, sans ces réglages côté Shopify.
{%- endcomment -%}
{%- liquid
  assign bp_color_label = ''
  for option in item.options_with_values
    if option.name == 'Couleur'
      assign bp_color_label = option.value
    endif
  endfor
  assign can_update_quantity = item.instructions.can_update_quantity | default: true
  assign can_remove = item.instructions.can_remove | default: true
-%}
<div class="bp-chip cart-item" id="CartItem-{{ item.index | plus: 1 }}">
  {%- if item.image -%}
    <span class="bp-chip__swatch-wrap">
      <img
        class="bp-chip__swatch"
        src="{{ item.image | image_url: width: 100 }}"
        alt="{{ item.image.alt | escape }}"
        loading="lazy"
        width="40"
        height="40"
      >
    </span>
  {%- endif -%}

  <div class="bp-chip__body">
    <div class="bp-chip__row1">
      <a href="{{ item.url }}" class="bp-chip__name cart-item__name">
        {{- bp_color_label | default: item.product.title | escape -}}
      </a>
    </div>
    <div class="bp-chip__price">{{ item.original_price | money }}</div>

    <div class="bp-chip__row2">
      <div class="cart-item__quantity-wrapper">
        <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
          {{ 'products.product.quantity.label' | t }}
        </label>
        <quantity-input class="quantity cart-quantity">
          <button
            class="quantity__button"
            name="minus"
            type="button"
            {% if can_update_quantity == false %}
              disabled
            {% endif %}
          >
            <span class="visually-hidden">
              {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
            </span>
            <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
          </button>
          {%- comment -%}
            step/data-min requis même sans règle de quantité réelle : CartItems.validateQuantity
            (cart.js) calcule `inputValue % parseInt(event.target.step)` à chaque changement — sans
            l'attribut step, `.step` vaut "" et parseInt("") vaut NaN, et un modulo par NaN n'est
            jamais égal à 0. Ça déclenchait le message d'erreur "incrément" du thème sur CHAQUE
            changement de quantité, même valide.
          {%- endcomment -%}
          <input
            class="quantity__input"
            data-quantity-variant-id="{{ item.variant.id }}"
            data-quantity-line-key="{{ item.key }}"
            type="number"
            name="updates[]"
            value="{{ item.quantity }}"
            {% # theme-check-disable %}
            data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
            min="0"
            data-min="0"
            step="1"
            {% # theme-check-enable %}
            aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
            id="Quantity-{{ item.index | plus: 1 }}"
            data-index="{{ item.index | plus: 1 }}"
            {% if can_update_quantity == false %}
              disabled
            {% endif %}
          >
          <button
            class="quantity__button"
            name="plus"
            type="button"
            {% if can_update_quantity == false %}
              disabled
            {% endif %}
          >
            <span class="visually-hidden">
              {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
            </span>
            <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
          </button>
        </quantity-input>
      </div>

      <span class="bp-chip__total">{{ item.original_line_price | money }}</span>

      <cart-remove-button
        id="Remove-{{ item.index | plus: 1 }}"
        data-index="{{ item.index | plus: 1 }}"
        {% if can_remove == false %}
          class="hidden"
        {% endif %}
      >
        <a
          href="{{ item.url_to_remove }}"
          class="button button--tertiary bp-chip__remove"
          aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
        >
          {%- comment -%}
            icon-close-small.svg (une croix) plutôt que l'icône poubelle par défaut du thème pour
            ce bouton — voir le CSS de main-cart-items.liquid pour le contexte.
          {%- endcomment -%}
          <span class="svg-wrapper">{{- 'icon-close-small.svg' | inline_asset_content -}}</span>
        </a>
      </cart-remove-button>
    </div>

    <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
      <small class="cart-item__error-text"></small>
      <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
    </div>
  </div>
</div>
