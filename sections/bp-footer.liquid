{% schema %}
{
  "name": "BeadPops Footer",
  "tag": "section",
  "class": "beadpops-section",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Signature",
      "default": "Le pixel art en beads. Choisis ton univers, suis les étapes, et repars avec un truc fait par toi."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Texte de copyright",
      "default": "Fait avec des Pops."
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "BeadPops Footer"
    }
  ]
}
{% endschema %}
