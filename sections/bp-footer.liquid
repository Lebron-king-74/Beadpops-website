      <span class="ft-copy">© {{ "now" | date: "%Y" }} BeadPops. {{ section.settings.copyright | escape }}</span>
      <div class="ft-legal"><a href="#">Mentions légales</a><a href="#">CGV</a><a href="#">Confidentialité</a></div>
