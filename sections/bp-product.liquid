<style>

@font-face{font-family:Silkscreen;src:url({{ 'bp-silkscreen-400.woff2' | asset_url }}) format('woff2');font-display:swap}
@font-face{font-family:Bricolage Grotesque;src:url({{ 'bp-bricolage-grotesque.woff2' | asset_url }}) format('woff2');font-weight:100 900;font-display:swap}
@font-face{font-family:Hanken Grotesk;src:url({{ 'bp-hanken-grotesk.woff2' | asset_url }}) format('woff2');font-weight:100 900;font-display:swap}
.bp-commerce{--void:#0C0B0B;--charcoal:#161412;--pearl:#F5EDE0;--sand:#C9A87C;--pop:#FF5C1A;color:var(--void);background:var(--pearl);font-family:Hanken Grotesk,sans-serif}
.bp-commerce *{box-sizing:border-box}.bp-commerce img,.bp-commerce video{display:block;max-width:100%}.bp-commerce a{color:inherit}.bp-wrap{width:min(calc(100% - 64px),1480px);margin-inline:auto}.bp-pixel{font-family:Silkscreen,monospace;letter-spacing:.08em;text-transform:uppercase}.bp-title{font-family:Bricolage Grotesque,sans-serif;font-weight:850;letter-spacing:-.045em}.bp-accent{color:var(--pop)}
@media(max-width:767px){.bp-wrap{width:min(calc(100% - 40px),1480px)}}

#bp-product-{{ section.id }}{overflow-x:clip}/* overflow-x:clip et non overflow:hidden : hidden fait de cet element le contexte de defilement de ses descendants et annule tout position:sticky, ce qui rendait la galerie et la colonne d achat non collantes. clip empeche le debordement horizontal sans creer ce contexte. */.bpp-main{padding:clamp(42px,6vw,90px) 0 80px}.bpp-crumbs{margin:0 0 24px;color:#6c6054;font-size:13px}.bpp-shell{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(420px,.95fr);gap:clamp(34px,5vw,86px);align-items:start}.bpp-gallery{display:grid;grid-template-columns:82px minmax(0,1fr);gap:14px;position:sticky;top:106px;align-self:start}.bpp-rail{display:grid;align-content:start;gap:10px}.bpp-thumb{aspect-ratio:1;border:1px solid rgba(12,11,11,.2);padding:0;background:#eadbc5;cursor:pointer}.bpp-thumb[aria-current=true]{outline:3px solid #FF5C1A;outline-offset:1px}.bpp-thumb img{width:100%;height:100%;object-fit:contain}.bpp-stage{position:relative;aspect-ratio:1;overflow:hidden;background:#e8d8c0}.bpp-stage img{width:100%;height:100%;object-fit:contain}/* contain et non cover : le flatlay est en 1,33 et cover le rognait de un quart, coupant les libelles en plein mot. Le fond teinte du cadre assume le ratio. */.bpp-buy{position:static}.bpp-kicker{margin:0 0 12px;color:#FF5C1A;font:400 11px/1.3 Silkscreen,monospace;letter-spacing:.08em;text-transform:uppercase}.bpp-buy h1{margin:0 0 16px;font:850 clamp(48px,5.6vw,86px)/.88 Bricolage Grotesque,sans-serif;letter-spacing:-.055em}.bpp-lead{margin:0 0 24px;color:#4f463e;font-size:19px;line-height:1.5}.bpp-facts{display:grid;grid-template-columns:repeat(3,1fr);margin-bottom:24px;border-block:1px solid rgba(12,11,11,.18)}.bpp-fact{padding:14px 10px 14px 0}.bpp-fact span,.bpp-fact strong{display:block}.bpp-fact span{margin-bottom:4px;color:#6c6054;font-size:12px}.bpp-fact strong{font-size:15px}.bpp-price{margin:0 0 18px;font:850 28px/1 Bricolage Grotesque,sans-serif}.bpp-variants{width:100%;margin-bottom:14px;padding:14px;border:1px solid rgba(12,11,11,.25);color:#0C0B0B;background:#F5EDE0;font:700 15px Hanken Grotesk,sans-serif}.bpp-add{width:100%;min-height:58px;border:0;color:#0C0B0B;background:#FF5C1A;font:850 18px/1 Bricolage Grotesque,sans-serif;cursor:pointer;clip-path:polygon(0 0,calc(100% - 10px) 0,calc(100% - 10px) 5px,100% 5px,100% 100%,10px 100%,10px calc(100% - 5px),0 calc(100% - 5px))}.bpp-add:disabled{opacity:.45;cursor:not-allowed}.bpp-desc{margin-top:24px;color:#4f463e;font-size:16px;line-height:1.6}.bpp-story{padding:clamp(76px,9vw,130px) 0;color:#F5EDE0;background:#0C0B0B}.bpp-story__head{display:grid;grid-template-columns:1fr .8fr;gap:36px;align-items:end;margin-bottom:40px}.bpp-story h2,.bpp-kit h2,.bpp-faq h2{margin:0;font:850 clamp(48px,6vw,92px)/.9 Bricolage Grotesque,sans-serif;letter-spacing:-.055em}.bpp-story__head p{max-width:42ch;margin:0;color:#C9A87C;font-size:18px;line-height:1.55}.bpp-story__grid{display:grid;grid-template-columns:1.25fr .75fr;gap:14px}.bpp-story__media{position:relative;min-height:560px;overflow:hidden;background:#161412}.bpp-story__media video,.bpp-story__media img{width:100%;height:100%;object-fit:cover}.bpp-story__steps{display:grid;grid-template-rows:repeat(3,1fr);gap:14px}.bpp-step{padding:28px;color:#0C0B0B;background:#F5EDE0}.bpp-step b{display:block;margin-bottom:12px;color:#FF5C1A;font:400 10px/1.3 Silkscreen,monospace;letter-spacing:.08em;text-transform:uppercase}.bpp-step strong{display:block;margin-bottom:8px;font:800 27px/1 Bricolage Grotesque,sans-serif}.bpp-step p{margin:0;color:#5f554b;line-height:1.5}.bpp-kit{padding:clamp(76px,9vw,130px) 0}.bpp-kit__grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,80px);align-items:center}.bpp-kit__media{aspect-ratio:5/4;overflow:hidden;background:#FF5C1A}.bpp-kit__media img{width:100%;height:100%;object-fit:cover}.bpp-kit__copy p{max-width:42ch;color:#4f463e;font-size:18px;line-height:1.55}.bpp-link{display:inline-flex;margin-top:14px;padding:15px 18px;color:#F5EDE0;background:#0C0B0B;font-weight:850;text-decoration:none}.bpp-faq{padding:clamp(76px,9vw,130px) 0;background:#eadbc5}.bpp-faq__grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(30px,7vw,110px)}.bpp-faq details{border-top:1px solid rgba(12,11,11,.25)}.bpp-faq details:last-child{border-bottom:1px solid rgba(12,11,11,.25)}.bpp-faq summary{padding:22px 0;font:800 20px/1.2 Bricolage Grotesque,sans-serif;cursor:pointer}.bpp-faq details div{padding:0 0 22px;color:#4f463e;line-height:1.6}
@media(max-width:980px){.bpp-shell{grid-template-columns:1fr}.bpp-gallery{position:static}.bpp-buy{position:static}.bpp-story__grid{grid-template-columns:1fr}.bpp-story__media{min-height:0;aspect-ratio:4/5}.bpp-story__steps{grid-template-columns:repeat(3,1fr);grid-template-rows:none}.bpp-kit__grid,.bpp-faq__grid{grid-template-columns:1fr}}@media(max-width:767px){.bpp-main{padding-top:28px}.bpp-gallery{grid-template-columns:1fr}.bpp-rail{grid-template-columns:repeat(4,1fr);grid-row:2}.bpp-buy h1{font-size:54px}.bpp-facts{grid-template-columns:1fr}.bpp-fact{display:flex;justify-content:space-between;gap:16px;padding-right:0}.bpp-story__head{grid-template-columns:1fr}.bpp-story__steps{grid-template-columns:1fr}.bpp-kit__grid{display:flex;flex-direction:column}.bpp-kit__media{width:100%}}
</style>
<div class="bp-commerce" id="bp-product-{{ section.id }}">
  <section class="bpp-main"><div class="bp-wrap"><p class="bpp-crumbs"><a href="{{ routes.root_url }}">Accueil</a> / {% if product.collections.first %}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> / {% endif %}{{ product.title }}</p><div class="bpp-shell"><div class="bpp-gallery"><div class="bpp-rail">{% for media in product.media limit: 4 %}<button class="bpp-thumb" type="button" data-bpp-thumb="{{ media.preview_image | image_url: width: 1200 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,140,180', alt: '' }}</button>{% else %}<button class="bpp-thumb" type="button" aria-current="true"><img src="{{ 'bp-commerce-product-fallback.webp' | asset_url }}" alt="" width="180" height="180"></button>{% endfor %}</div><div class="bpp-stage">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1400', alt: product.title, id: 'bpp-main-image' }}{% else %}<img id="bpp-main-image" src="{{ 'bp-commerce-product-fallback.webp' | asset_url }}" alt="" width="1000" height="1000" fetchpriority="high">{% endif %}</div></div><div class="bpp-buy"><p class="bpp-kicker">{{ section.settings.eyebrow | escape }}</p><h1>{{ product.title | escape }}</h1><p class="bpp-lead">{{ section.settings.lead | escape }}</p>{% assign difficulty = product.metafields.custom.difficulty.value | default: product.metafields.custom.difficulty %}{% assign duration = product.metafields.custom.estimated_time.value | default: product.metafields.custom.estimated_time %}{% assign universe = product.metafields.custom.universe.value | default: product.metafields.custom.universe %}{% if difficulty != blank or duration != blank or universe != blank %}<div class="bpp-facts">{% if difficulty != blank %}<div class="bpp-fact"><span>Niveau</span><strong>{{ difficulty }}</strong></div>{% endif %}{% if duration != blank %}<div class="bpp-fact"><span>Temps indicatif</span><strong>{{ duration }}</strong></div>{% endif %}{% if universe != blank %}<div class="bpp-fact"><span>Univers</span><strong>{{ universe }}</strong></div>{% endif %}</div>{% endif %}{%- if product.type == 'Starter Kit' -%}{%- render 'bp-kit-composer', product: product -%}{%- else -%}<p class="bpp-price">{{ product.selected_or_first_available_variant.price | money }}</p>{% form 'product', product %}{% if product.has_only_default_variant == false %}<select class="bpp-variants" name="id" aria-label="Choisir une option">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} indisponible{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endif %}<button class="bpp-add" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Ajouter au panier{% else %}Indisponible{% endif %}</button>{% endform %}{%- endif -%}{% if product.description != blank %}<div class="bpp-desc">{{ product.description }}</div>{% endif %}</div></div></div></section>
  <section class="bpp-story"><div class="bp-wrap"><div class="bpp-story__head"><h2>{{ section.settings.story_title | escape }}</h2><p>{{ section.settings.story_text | escape }}</p></div><div class="bpp-story__grid"><div class="bpp-story__media">{% if section.settings.story_video != blank %}{{ section.settings.story_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}{% elsif section.settings.story_image != blank %}{{ section.settings.story_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640,960,1280,1600', alt: '' }}{% else %}<video src="{{ 'bp-commerce-process.mp4' | asset_url }}" autoplay muted loop playsinline preload="metadata"></video>{% endif %}</div><div class="bpp-story__steps">{% for block in section.blocks %}{% if block.type == 'step' %}<article class="bpp-step" {{ block.shopify_attributes }}><b>Étape {{ forloop.index }}</b><strong>{{ block.settings.title | escape }}</strong><p>{{ block.settings.text | escape }}</p></article>{% endif %}{% endfor %}</div></div></div></section>
  <section class="bpp-kit"><div class="bpp-kit__grid bp-wrap"><div class="bpp-kit__media">{% if section.settings.kit_image != blank %}{{ section.settings.kit_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640,960,1280,1600', alt: section.settings.kit_title }}{% else %}<img src="{{ 'bp-commerce-starter-kit.webp' | asset_url }}" alt="" width="1280" height="1024" loading="lazy">{% endif %}</div><div class="bpp-kit__copy"><p class="bpp-kicker">{{ section.settings.kit_eyebrow | escape }}</p><h2>{{ section.settings.kit_title | escape }}</h2><p>{{ section.settings.kit_text | escape }}</p>{% assign kit_url = section.settings.kit_product.url | default: section.settings.kit_link %}{% if kit_url != blank %}<a class="bpp-link" href="{{ kit_url }}">{{ section.settings.kit_cta | escape }} →</a>{% endif %}</div></div></section>
  <section class="bpp-faq"><div class="bpp-faq__grid bp-wrap"><div><p class="bpp-kicker">Avant de commencer</p><h2>{{ section.settings.faq_title | escape }}</h2></div><div>{% for block in section.blocks %}{% if block.type == 'faq' %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><div>{{ block.settings.answer }}</div></details>{% endif %}{% endfor %}</div></div></section>
</div>
<script>(function(){const root=document.querySelector('#bp-product-{{ section.id }}');if(!root)return;const main=root.querySelector('#bpp-main-image');root.querySelectorAll('[data-bpp-thumb]').forEach(btn=>btn.addEventListener('click',()=>{if(!main)return;main.src=btn.dataset.bppThumb;root.querySelectorAll('[data-bpp-thumb]').forEach(x=>x.setAttribute('aria-current','false'));btn.setAttribute('aria-current','true')}));})();</script>
{% schema %}
{"name":"Produit BeadPops","settings":[{"type":"text","id":"eyebrow","label":"Surtitre","default":"Design guidé BeadPops"},{"type":"textarea","id":"lead","label":"Accroche","default":"Choisis les couleurs, suis la grille et regarde ton design prendre vie Pop après Pop."},{"type":"text","id":"story_title","label":"Titre démonstration","default":"Regarde-le apparaître."},{"type":"textarea","id":"story_text","label":"Texte démonstration","default":"Le geste est simple. Le résultat se révèle petit à petit, sans avoir besoin de savoir dessiner."},{"type":"video","id":"story_video","label":"Vidéo démonstration"},{"type":"image_picker","id":"story_image","label":"Image de secours"},{"type":"text","id":"kit_eyebrow","label":"Surtitre Starter Kit","default":"La bonne base"},{"type":"text","id":"kit_title","label":"Titre Starter Kit","default":"Commence avec tout ce qu’il faut."},{"type":"textarea","id":"kit_text","label":"Texte Starter Kit","default":"Le Starter Kit réunit le matériel utile pour créer proprement et passer d’un design au suivant."},{"type":"image_picker","id":"kit_image","label":"Image Starter Kit"},{"type":"product","id":"kit_product","label":"Produit Starter Kit"},{"type":"url","id":"kit_link","label":"Lien Starter Kit de secours"},{"type":"text","id":"kit_cta","label":"CTA Starter Kit","default":"Découvrir le Starter Kit"},{"type":"text","id":"faq_title","label":"Titre FAQ","default":"Les réponses utiles."}],"blocks":[{"type":"step","name":"Étape","settings":[{"type":"text","id":"title","label":"Titre","default":"Poser une couleur"},{"type":"textarea","id":"text","label":"Texte","default":"Commence par une teinte, puis avance à ton rythme."}]},{"type":"faq","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Comment choisir mon niveau ?"},{"type":"richtext","id":"answer","label":"Réponse","default":"<p>Le niveau et le temps indicatif sont affichés dès qu’ils sont renseignés sur la fiche produit.</p>"}]}],"presets":[{"name":"Produit BeadPops","blocks":[{"type":"step","settings":{"title":"Poser une couleur","text":"Commence par une teinte et une zone simple."}},{"type":"step","settings":{"title":"Répéter, ça se révèle","text":"Pop après Pop, l’image apparaît sous tes yeux."}},{"type":"step","settings":{"title":"Admirer le résultat","text":"Ton design est prêt à être gardé, offert ou affiché."}},{"type":"faq"},{"type":"faq","settings":{"question":"Le Starter Kit est-il nécessaire ?","answer":"<p>Relie ici la réponse exacte selon le contenu de ton offre Shopify.</p>"}}]}]}
{% endschema %}