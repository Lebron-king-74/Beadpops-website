<style>

@font-face{font-family:Silkscreen;src:url({{ 'bp-silkscreen-400.woff2' | asset_url }}) format('woff2');font-display:swap}
@font-face{font-family:Bricolage Grotesque;src:url({{ 'bp-bricolage-grotesque.woff2' | asset_url }}) format('woff2');font-weight:100 900;font-display:swap}
@font-face{font-family:Hanken Grotesk;src:url({{ 'bp-hanken-grotesk.woff2' | asset_url }}) format('woff2');font-weight:100 900;font-display:swap}
.bp-commerce{--void:#0C0B0B;--charcoal:#161412;--pearl:#F5EDE0;--sand:#C9A87C;--pop:#FF5C1A;color:var(--void);background:var(--pearl);font-family:Hanken Grotesk,sans-serif}
.bp-commerce *{box-sizing:border-box}.bp-commerce img,.bp-commerce video{display:block;max-width:100%}.bp-commerce a{color:inherit}.bp-wrap{width:min(calc(100% - 64px),1480px);margin-inline:auto}.bp-pixel{font-family:Silkscreen,monospace;letter-spacing:.08em;text-transform:uppercase}.bp-title{font-family:Bricolage Grotesque,sans-serif;font-weight:850;letter-spacing:-.045em}.bp-accent{color:var(--pop)}
@media(max-width:767px){.bp-wrap{width:min(calc(100% - 40px),1480px)}}

#bp-collection-{{ section.id }}{overflow:hidden}.bpc-hero{color:#F5EDE0;background:#0C0B0B}.bpc-hero__grid{min-height:min(660px,76vh);display:grid;grid-template-columns:minmax(0,.85fr) minmax(520px,1.15fr);align-items:stretch}.bpc-hero__copy{padding:clamp(70px,8vw,126px) clamp(24px,5vw,86px) clamp(60px,7vw,110px) 0;display:flex;flex-direction:column;justify-content:center}.bpc-kicker{margin:0 0 20px;color:#FF5C1A;font:400 11px/1.3 Silkscreen,monospace;letter-spacing:.1em;text-transform:uppercase}.bpc-hero h1{margin:0 0 24px;color:#F5EDE0;font:850 clamp(66px,9vw,150px)/.82 Bricolage Grotesque,sans-serif;letter-spacing:-.07em}.bpc-hero__intro{max-width:36ch;margin:0 0 34px;color:#F5EDE0;font-size:clamp(19px,1.7vw,27px);line-height:1.45}.bpc-hero__link{width:max-content;display:inline-flex;align-items:center;gap:16px;padding:16px 18px;color:#0C0B0B;background:#FF5C1A;font-weight:850;text-decoration:none}.bpc-hero__media{position:relative;min-height:520px;background:#FF5C1A}.bpc-hero__media img{width:100%;height:100%;object-fit:cover}.bpc-catalog{padding:clamp(70px,8vw,120px) 0}.bpc-top{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:34px}.bpc-top h2{max-width:12ch;margin:0;font:850 clamp(42px,5vw,76px)/.92 Bricolage Grotesque,sans-serif;letter-spacing:-.055em}.bpc-top p{max-width:44ch;margin:0;color:#5f554b;font-size:17px;line-height:1.55}.bpc-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(16px,2vw,28px)}.bpc-card{position:relative;color:#0C0B0B;text-decoration:none}.bpc-card__media{position:relative;aspect-ratio:4/5;overflow:hidden;background:#e8d8c0}.bpc-card__media img{width:100%;height:100%;object-fit:cover;transition:transform .5s cubic-bezier(.16,1,.3,1)}.bpc-card:hover img{transform:scale(1.035)}.bpc-card__body{padding:18px 0 24px;border-bottom:1px solid rgba(12,11,11,.22)}.bpc-card__meta{margin-bottom:8px;color:#FF5C1A;font:400 10px/1.3 Silkscreen,monospace;letter-spacing:.08em;text-transform:uppercase}.bpc-card h3{margin:0 0 12px;font:800 24px/1 Bricolage Grotesque,sans-serif}.bpc-specs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}.bpc-spec{padding:7px 9px;background:#eadbc5;font-size:12px;font-weight:750}.bpc-price{margin:0;font-weight:850}.bpc-empty{grid-column:1/-1;padding:70px 24px;text-align:center;border:1px solid rgba(12,11,11,.18)}.bpc-empty h3{margin:0 0 8px;font:800 32px/1 Bricolage Grotesque,sans-serif}.bpc-worlds{padding:clamp(64px,8vw,112px) 0;color:#F5EDE0;background:#161412}.bpc-worlds__head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:30px}.bpc-worlds h2{max-width:10ch;margin:0;font:850 clamp(46px,6vw,86px)/.9 Bricolage Grotesque,sans-serif;letter-spacing:-.055em}.bpc-worlds__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.bpc-world{position:relative;min-height:300px;overflow:hidden;color:#F5EDE0;text-decoration:none}.bpc-world img{width:100%;height:100%;object-fit:cover}.bpc-world:after{content:"";position:absolute;inset:30% 0 0;background:linear-gradient(transparent,rgba(12,11,11,.9))}.bpc-world span{position:absolute;z-index:2;right:22px;bottom:20px;left:22px;display:flex;justify-content:space-between;font:800 28px/1 Bricolage Grotesque,sans-serif}.bpc-world span:after{content:"→";color:#FF5C1A}
@media(max-width:1050px){.bpc-hero__grid{grid-template-columns:1fr 1fr}.bpc-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:767px){.bpc-hero__grid{min-height:auto;grid-template-columns:1fr}.bpc-hero__copy{padding:64px 0 44px}.bpc-hero h1{font-size:68px}.bpc-hero__media{min-height:0;aspect-ratio:5/4}.bpc-top{align-items:start;flex-direction:column}.bpc-grid{grid-template-columns:1fr 1fr;gap:14px}.bpc-card h3{font-size:20px}.bpc-card__body{padding-top:13px}.bpc-worlds__head{align-items:start;flex-direction:column}.bpc-worlds__grid{grid-template-columns:1fr}.bpc-world{min-height:220px}}@media(max-width:420px){.bpc-grid{grid-template-columns:1fr}}
</style>
<div class="bp-commerce" id="bp-collection-{{ section.id }}">
  <section class="bpc-hero"><div class="bpc-hero__grid bp-wrap"><div class="bpc-hero__copy"><p class="bpc-kicker">{{ section.settings.eyebrow | escape }}</p><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="bpc-hero__intro">{{ collection.description }}</div>{% else %}<p class="bpc-hero__intro">{{ section.settings.intro | escape }}</p>{% endif %}<a class="bpc-hero__link" href="#bpc-products">{{ section.settings.cta_label | escape }} <span aria-hidden="true">↓</span></a></div><div class="bpc-hero__media">{% if collection.image != blank %}{{ collection.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '640,960,1280,1800', alt: collection.title }}{% elsif section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '640,960,1280,1800', alt: collection.title }}{% else %}<img src="{{ 'bp-menu-kawaii.webp' | asset_url }}" alt="" width="1280" height="960" fetchpriority="high">{% endif %}</div></div></section>
  <section class="bpc-catalog" id="bpc-products"><div class="bp-wrap"><div class="bpc-top"><h2>{{ section.settings.catalog_title | escape }}</h2><p>{{ section.settings.catalog_text | escape }}</p></div><div class="bpc-grid">{% paginate collection.products by section.settings.products_per_page %}{% for item in collection.products %}<a class="bpc-card" href="{{ item.url }}"><div class="bpc-card__media">{% if item.featured_image != blank %}{{ item.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', alt: item.title }}{% else %}<img src="{{ 'bp-commerce-product-fallback.webp' | asset_url }}" alt="" width="720" height="960" loading="lazy">{% endif %}</div><div class="bpc-card__body"><div class="bpc-card__meta">{{ collection.title | escape }}</div><h3>{{ item.title | escape }}</h3>{% assign difficulty = item.metafields.custom.difficulty.value | default: item.metafields.custom.difficulty %}{% assign duration = item.metafields.custom.estimated_time.value | default: item.metafields.custom.estimated_time %}{% if difficulty != blank or duration != blank %}<div class="bpc-specs">{% if difficulty != blank %}<span class="bpc-spec">Niveau {{ difficulty }}</span>{% endif %}{% if duration != blank %}<span class="bpc-spec">{{ duration }}</span>{% endif %}</div>{% endif %}<p class="bpc-price">{{ item.price | money }}</p></div></a>{% else %}<div class="bpc-empty"><h3>La collection se prépare.</h3><p>Ajoute les produits dans Shopify pour les faire apparaître ici.</p></div>{% endfor %}{% if paginate.pages > 1 %}<div class="bpc-empty">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</div></div></section>
  {% if section.blocks.size > 0 %}<section class="bpc-worlds"><div class="bp-wrap"><div class="bpc-worlds__head"><h2>{{ section.settings.worlds_title | escape }}</h2><p>{{ section.settings.worlds_text | escape }}</p></div><div class="bpc-worlds__grid">{% for block in section.blocks %}{% assign world_url = block.settings.collection.url | default: routes.all_products_collection_url %}<a class="bpc-world" href="{{ world_url }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '480,720,1000', alt: block.settings.title }}{% else %}<img src="{{ block.settings.fallback_asset | asset_url }}" alt="" width="640" height="480" loading="lazy">{% endif %}<span>{{ block.settings.title | escape }}</span></a>{% endfor %}</div></div></section>{% endif %}
</div>
{% schema %}
{"name":"Collection BeadPops","settings":[{"type":"text","id":"eyebrow","label":"Surtitre","default":"Trouve ton prochain design"},{"type":"textarea","id":"intro","label":"Introduction de secours","default":"Choisis le design qui te donne envie de poser la première Pop."},{"type":"text","id":"cta_label","label":"CTA","default":"Voir les designs"},{"type":"image_picker","id":"hero_image","label":"Image hero de secours"},{"type":"text","id":"catalog_title","label":"Titre catalogue","default":"Les designs de la collection"},{"type":"textarea","id":"catalog_text","label":"Texte catalogue","default":"Chaque modèle te guide Pop après Pop. Le niveau et le temps apparaissent dès qu’ils sont renseignés sur le produit."},{"type":"range","id":"products_per_page","label":"Produits par page","min":4,"max":24,"step":4,"default":12},{"type":"text","id":"worlds_title","label":"Titre autres univers","default":"Pas encore le déclic ?"},{"type":"textarea","id":"worlds_text","label":"Texte autres univers","default":"Change d’univers. Ton prochain design est peut-être juste à côté."}],"blocks":[{"type":"world","name":"Autre univers","settings":[{"type":"text","id":"title","label":"Nom","default":"Fantasy"},{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"fallback_asset","label":"Visuel par défaut","default":"bp-menu-fantasy.webp","options":[{"value":"bp-menu-kawaii.webp","label":"Kawaii"},{"value":"bp-menu-fantasy.webp","label":"Fantasy"},{"value":"bp-menu-anime.webp","label":"Anime"},{"value":"bp-menu-cartoons.webp","label":"Cartoons"}]}]}],"max_blocks":3,"presets":[{"name":"Collection BeadPops","blocks":[{"type":"world","settings":{"title":"Fantasy","fallback_asset":"bp-menu-fantasy.webp"}},{"type":"world","settings":{"title":"Anime","fallback_asset":"bp-menu-anime.webp"}},{"type":"world","settings":{"title":"Cartoons","fallback_asset":"bp-menu-cartoons.webp"}}]}]}
{% endschema %}