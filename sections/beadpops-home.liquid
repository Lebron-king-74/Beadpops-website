  #bp-forwho .fw-card:nth-last-child(-n+2){ border-bottom:1px solid color-mix(in srgb,#0C0B0B 30%,transparent); }
  #bp-forwho .fw-media{ aspect-ratio:4/5; background:#F5EDE0; border:1px solid color-mix(in srgb,#0C0B0B 18%,transparent); border-radius:4px; color:color-mix(in srgb,#0C0B0B 30%,transparent); display:flex; align-items:center; justify-content:center; overflow:hidden; }
  #bp-forwho .fw-media .wf-ic{ width:24%; max-width:46px; }
