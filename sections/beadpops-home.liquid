{% liquid
  assign primary_cta_url = section.settings.starter_product.url | default: '#bp-offer'
  assign easy_collection_url = section.settings.easy_collection.url | default: '#bp-modes'
  assign medium_collection_url = section.settings.medium_collection.url | default: '#bp-modes'
  assign boss_collection_url = section.settings.boss_collection.url | default: '#bp-modes'
  assign kawaii_collection_url = section.settings.kawaii_collection.url | default: '#bp-universe'
  assign gaming_collection_url = section.settings.gaming_collection.url | default: '#bp-universe'
  assign fantasy_collection_url = section.settings.fantasy_collection.url | default: '#bp-universe'
  assign animals_collection_url = section.settings.animals_collection.url | default: '#bp-universe'
%}

<style>
@font-face{font-family:'Silkscreen';src:url({{ 'bp-silkscreen-400.woff2' | asset_url }}) format('woff2');font-style:normal;font-weight:400;font-display:swap}
@font-face{font-family:'Silkscreen';src:url({{ 'bp-silkscreen-700.woff2' | asset_url }}) format('woff2');font-style:normal;font-weight:700;font-display:swap}
@font-face{font-family:'Bricolage Grotesque';src:url({{ 'bp-bricolage-grotesque.woff2' | asset_url }}) format('woff2');font-style:normal;font-weight:100 900;font-display:swap}
@font-face{font-family:'Hanken Grotesk';src:url({{ 'bp-hanken-grotesk.woff2' | asset_url }}) format('woff2');font-style:normal;font-weight:100 900;font-display:swap}

  #beadpops-home-{{ section.id }}{
    --brand-bg:#0C0B0B; --brand-surface:#161412; --brand-accent:#FF5C1A;
    --brand-text:#F5EDE0; --brand-text-muted:#C9A87C;
    --brand-font-display:'Silkscreen',monospace;
    --brand-font-title:'Bricolage Grotesque',sans-serif;
    --brand-font-body:'Hanken Grotesk',system-ui,sans-serif;
    --lp-content-max:1480px;
    --lp-gutter:20px;
  }
  #beadpops-home-{{ section.id }},#beadpops-home-{{ section.id }} *,#beadpops-home-{{ section.id }} *::before,#beadpops-home-{{ section.id }} *::after{box-sizing:border-box;}

  #beadpops-home-{{ section.id }}{margin:0;padding:0;overflow-x:clip;background:var(--brand-bg);color:var(--brand-text);font-family:var(--brand-font-body);}
  #beadpops-home-{{ section.id }} img{max-width:100%;}
  #beadpops-home-{{ section.id }} .lp-wrap{width:min(calc(100% - (2 * var(--lp-gutter))),var(--lp-content-max));margin-inline:auto;}
  @media (min-width:768px){#beadpops-home-{{ section.id }}{--lp-gutter:24px;}}
  @media (min-width:1024px){#beadpops-home-{{ section.id }}{--lp-gutter:32px;}}
  /* Repli global : respecte prefers-reduced-motion (anime seulement en enhance) */
  @media (prefers-reduced-motion:reduce){
    #beadpops-home-{{ section.id }},#beadpops-home-{{ section.id }} *,#beadpops-home-{{ section.id }} *::before,#beadpops-home-{{ section.id }} *::after{ animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; scroll-behavior:auto !important; }
  }

  /* Mouvement de page : entrée cadrée, contenu visible sans JavaScript */
  .bp-motion{ opacity:1; transform:none; clip-path:inset(0); }
  html.motion-ready .bp-motion:not(.is-visible){ opacity:.001; transform:translateY(14px); clip-path:inset(0 0 10% 0); filter:blur(3px); }
  html.motion-ready .bp-motion.is-visible{ filter:none; transition:opacity .48s cubic-bezier(.16,1,.3,1),transform .56s cubic-bezier(.16,1,.3,1),clip-path .62s cubic-bezier(.16,1,.3,1),filter .42s cubic-bezier(.16,1,.3,1); transition-delay:var(--motion-delay,0ms); }
  html.motion-ready #bp-modes .md-card.bp-motion:not(.is-visible),html.motion-ready #bp-compare .cx-row.bp-motion:not(.is-visible){ transform:translateY(10px); clip-path:inset(0 0 18% 0); }
  html.motion-ready #bp-how .hw-step.bp-motion:not(.is-visible){ transform:translateY(20px); clip-path:inset(0 0 22% 0); }
  #bp-how .hw-media::after{ content:""; position:absolute; z-index:3; left:0; right:0; bottom:0; height:4px; background:var(--brand-accent); transform:scaleX(0); transform-origin:left; opacity:0; pointer-events:none; }
  #bp-how .hw-step.bp-motion.is-visible .hw-media::after{ animation:bp-pop-line .62s cubic-bezier(.16,1,.3,1) var(--motion-delay,0ms) both; }
  @keyframes bp-pop-line{ 0%{transform:scaleX(0);opacity:0;} 18%{opacity:1;} 72%{transform:scaleX(1);opacity:1;} 100%{transform:scaleX(1);opacity:0;} }
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto;}
    .bp-motion,html.motion-ready .bp-motion:not(.is-visible){ opacity:1; transform:none; clip-path:none; filter:none; }
    #bp-how .hw-step.bp-motion.is-visible .hw-media::after{ animation:none; }
  }

  /* ===== HERO ===== */
  #os-hero{ background:radial-gradient(circle at 78% 42%,color-mix(in srgb,var(--brand-accent) 14%,transparent) 0%,transparent 36%),var(--brand-bg); color:var(--brand-text); padding:clamp(38px,4.5vw,68px) 0; overflow-x:hidden; }
  #os-hero .os-hero-grid{
    display:grid;
    grid-template-columns:minmax(0,0.95fr) minmax(0,1.15fr);
    grid-template-areas:"head visual" "body visual";
    column-gap:clamp(32px,5vw,72px);
    row-gap:clamp(22px,2.6vw,34px);          /* FIX 3 : air entre sous-titre (head) et bullets (body) */
    align-content:center;
  }
  #os-hero .os-hero-head{ grid-area:head; }
  #os-hero .os-hero-body{ grid-area:body; }
  #os-hero .os-hero-visual{ grid-area:visual; align-self:center; }

  @keyframes os-hero-in{ from{opacity:0;transform:translateY(14px);} to{opacity:1;transform:none;} }
  #os-hero .os-hero-head, #os-hero .os-hero-visual, #os-hero .os-hero-body{ animation:os-hero-in .55s cubic-bezier(.22,.61,.36,1) both; }
  #os-hero .os-hero-visual{ animation-delay:.08s; }
  #os-hero .os-hero-body{ animation-delay:.14s; }
  @media (prefers-reduced-motion:reduce){ #os-hero .os-hero-head,#os-hero .os-hero-visual,#os-hero .os-hero-body{ animation:none; } }

  #os-hero .os-hero-eyebrow{ font-family:var(--brand-font-display); color:var(--brand-accent); font-size:12px; letter-spacing:.08em; text-transform:uppercase; margin:0 0 20px; }
  #os-hero .os-hero-title{ font-family:var(--brand-font-title); font-weight:800; color:var(--brand-text); font-size:clamp(30px,4.6vw,64px); line-height:1.04; letter-spacing:-.02em; margin:0; text-wrap:balance; }
  #os-hero .os-accent{ color:var(--brand-accent); }
  /* FIX 1 : sous-titre en blanc (Pearl), plus en beige */
  #os-hero .os-hero-sub{ font-family:var(--brand-font-body); color:var(--brand-text); font-size:clamp(16px,1.4vw,19px); line-height:1.5; max-width:52ch; margin:20px 0 0; overflow-wrap:break-word; }

  /* Bullets = chips 2x2 avec badge rond */
  #os-hero .os-hero-checks{ list-style:none; padding:0; margin:0; display:grid; grid-template-columns:1fr 1fr; gap:12px; max-width:480px; align-items:stretch; }
  #os-hero .os-hero-checks li{ display:flex; align-items:center; gap:10px; background:var(--brand-surface); border:0; border-radius:8px; padding:11px 14px; color:var(--brand-text); font-weight:600; font-size:14px; line-height:1.2; }
  #os-hero .os-check{ flex:none; width:22px; height:22px; border-radius:50%; background:var(--brand-accent); color:var(--brand-bg); display:inline-flex; align-items:center; justify-content:center; font-size:12px; font-weight:800; }

  /* FIX 2 : texte du CTA en blanc, plus en noir */
  #os-hero .os-hero-cta{ display:inline-block; margin:26px 0 0; background:var(--brand-accent); color:var(--brand-text); font-family:var(--brand-font-title); font-weight:800; font-size:17px; padding:16px 30px; border-radius:8px; text-decoration:none; box-shadow:0 4px 0 rgba(0,0,0,.35); }
  #os-hero .os-hero-cta:focus-visible{ outline:3px solid var(--brand-text); outline-offset:3px; }
  #os-hero .os-hero-meta{ display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin:14px 0 0; color:var(--brand-text-muted); font-size:13px; }

  /* ===== Compo transformation : DE ÇA / AVEC ÇA / À ÇA ===== */
  /* FIX 5 : visuel plus grand */
  #os-hero .os-hero-visual.is-tf{ overflow:visible; }
  #os-hero .os-tf{ position:relative; width:100%; max-width:620px; margin:0 auto; aspect-ratio:1/1; }
  #os-hero .os-tf-card{ position:absolute; border-radius:8px; overflow:hidden; background:color-mix(in srgb, var(--brand-surface) 84%, var(--brand-text) 16%); box-shadow:0 16px 36px -18px rgba(0,0,0,.8); }
  #os-hero .os-tf-card img, #os-hero .os-tf-card video{ width:100%; height:100%; object-fit:cover; display:block; }
  #os-hero .os-tf-ph{ width:100%; height:100%; display:flex; align-items:center; justify-content:center; border:2px dashed color-mix(in srgb, var(--brand-accent) 50%, transparent); border-radius:8px; font-family:var(--brand-font-display); font-size:10px; letter-spacing:.06em; text-transform:uppercase; color:var(--brand-text-muted); }
  #os-hero .os-tf-before{ width:54%; aspect-ratio:3/4; left:0; bottom:0; transform:rotate(-6deg); z-index:1; }
  #os-hero .os-tf-after { width:54%; aspect-ratio:3/4; right:0; bottom:0; transform:rotate(6deg); z-index:2; }
  #os-hero .os-tf-lbl{ position:absolute; z-index:5; font-family:var(--brand-font-display); font-size:clamp(10px,.82vw,12px); line-height:1; letter-spacing:.04em; text-transform:uppercase; color:#0C0B0B; background:var(--brand-accent); border:1px solid color-mix(in srgb,#F5EDE0 28%,transparent); border-radius:3px; padding:7px 10px; box-shadow:0 4px 0 #0C0B0B,0 10px 24px -12px rgba(12,11,11,.45); }
  #os-hero .os-tf-lbl-before{ top:4%; left:2%; }
  #os-hero .os-tf-lbl-after{ top:4%; right:2%; text-align:right; }
  #os-hero .os-tf-arrow{ position:absolute; z-index:4; pointer-events:none; overflow:visible; }
  #os-hero .os-tf-arrow .sh{ stroke:var(--brand-accent); stroke-width:5; fill:none; stroke-linecap:round; stroke-linejoin:round; }
  #os-hero .os-tf-arrow .hd{ fill:var(--brand-accent); }
  #os-hero .os-tf-arrow svg{ filter:drop-shadow(0 3px 0 #0C0B0B) drop-shadow(0 6px 10px color-mix(in srgb,var(--brand-accent) 34%,transparent)); }
  #os-hero .os-tf-arrow-1{ top:12%; left:6%; width:60px; height:80px; }
  #os-hero .os-tf-arrow-2{ top:12%; right:6%; width:60px; height:80px; transform:scaleX(-1); }
  #os-hero .os-tf-lbl,#os-hero .os-tf-arrow{ animation:os-signal-in .64s cubic-bezier(.16,1,.3,1) both; }
  #os-hero .os-tf-lbl-before{ animation-delay:.22s; }
  #os-hero .os-tf-lbl-after{ animation-delay:.34s; }
  #os-hero .os-tf-arrow-1{ animation-delay:.32s; }
  #os-hero .os-tf-arrow-2{ animation-delay:.44s; }
  @keyframes os-signal-in{ from{ opacity:0; clip-path:inset(0 0 100% 0); filter:blur(3px); } to{ opacity:1; clip-path:inset(0); filter:none; } }

  /* ===== Mobile : empilé + tout centré (FIX 4) ===== */
  @media (max-width:960px){
    #os-hero .os-hero-grid{ grid-template-columns:minmax(0,1fr); grid-template-areas:"head" "visual" "body"; row-gap:30px; }
    #os-hero .os-hero-head, #os-hero .os-hero-body{ text-align:center; }
    #os-hero .os-hero-sub{ margin-inline:auto; }
    #os-hero .os-hero-checks{ margin-inline:auto; }
    #os-hero .os-hero-checks li{ justify-content:center; text-align:center; }
    #os-hero .os-hero-meta{ justify-content:center; }
    #os-hero .os-tf{ max-width:460px; }
    #os-hero .os-tf-before, #os-hero .os-tf-after{ width:56%; }
  }

  /* ===== GALERIE CINETIQUE ===== */
  #bp-visual-loop{
    --vl-gap:clamp(12px,1.25vw,20px);
    position:relative;
    isolation:isolate;
    overflow:hidden;
    padding:clamp(16px,1.8vw,26px) 0 clamp(24px,2.8vw,40px);
    background:linear-gradient(160deg,#F5EDE0 0%,#EFE3D2 52%,#F5EDE0 100%);
  }
  #bp-visual-loop::before{
    content:"";
    position:absolute;
    z-index:0;
    inset:0;
    background:linear-gradient(90deg,color-mix(in srgb,var(--brand-accent) 7%,transparent),transparent 18% 82%,color-mix(in srgb,var(--brand-accent) 5%,transparent));
    pointer-events:none;
  }
  #bp-visual-loop .vl-viewport{
    position:relative;
    z-index:1;
    overflow:hidden;
    -webkit-mask-image:linear-gradient(90deg,transparent 0,#0C0B0B 4%,#0C0B0B 96%,transparent 100%);
    mask-image:linear-gradient(90deg,transparent 0,#0C0B0B 4%,#0C0B0B 96%,transparent 100%);
  }
  #bp-visual-loop .vl-row{
    display:flex;
    width:max-content;
    transform:translate3d(0,0,0);
    animation:vl-left 38s linear infinite;
    animation-play-state:paused;
    will-change:transform;
  }
  #bp-visual-loop.is-running .vl-row{ animation-play-state:running; }
  #bp-visual-loop:hover .vl-row{ animation-play-state:paused; }
  #bp-visual-loop .vl-group{
    display:flex;
    flex:none;
    gap:var(--vl-gap);
    padding-right:var(--vl-gap);
  }
  #bp-visual-loop .vl-card{
    position:relative;
    flex:none;
    margin:0;
    width:clamp(150px,12vw,192px);
    aspect-ratio:3/4;
    overflow:hidden;
    border:1px solid color-mix(in srgb,#0C0B0B 14%,transparent);
    border-radius:4px;
    background:#EFE3D2;
  }
  #bp-visual-loop .vl-card img,
  #bp-visual-loop .vl-card video{
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    background:#161412;
  }
  @keyframes vl-left{ from{ transform:translate3d(0,0,0); } to{ transform:translate3d(-50%,0,0); } }
  @media (max-width:700px){
    #bp-visual-loop{ --vl-gap:10px; padding:12px 0 24px; }
    #bp-visual-loop .vl-card{ width:clamp(132px,40vw,158px); }
    #bp-visual-loop .vl-row{ animation-duration:29s; }
    #bp-visual-loop .vl-viewport{
      -webkit-mask-image:linear-gradient(90deg,transparent 0,#0C0B0B 5%,#0C0B0B 95%,transparent 100%);
      mask-image:linear-gradient(90deg,transparent 0,#0C0B0B 5%,#0C0B0B 95%,transparent 100%);
    }
  }
  @media (prefers-reduced-motion:reduce){
    #bp-visual-loop .vl-viewport{ overflow-x:auto; scrollbar-width:none; -webkit-mask-image:none; mask-image:none; }
    #bp-visual-loop .vl-viewport::-webkit-scrollbar{ display:none; }
    #bp-visual-loop .vl-row{ animation:none; transform:none; will-change:auto; }
    #bp-visual-loop .vl-group[aria-hidden="true"]{ display:none; }
  }

  /* ===== SECTION 2 - UNIVERS (fond clair) ===== */
  #bp-universe{ background:linear-gradient(145deg,#F5EDE0 0%,color-mix(in srgb,var(--brand-accent) 5%,#F5EDE0) 58%,#F5EDE0 100%); color:#0C0B0B; padding:clamp(38px,4.5vw,68px) 0; }
  #bp-universe .uv-head{ text-align:center; max-width:640px; margin:0 auto clamp(20px,2.6vw,30px); }
  #bp-universe .uv-eyebrow{ font-family:var(--brand-font-display); font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:#0C0B0B; margin:0 0 12px; }
  #bp-universe .uv-title{ font-family:var(--brand-font-title); font-weight:800; color:#0C0B0B; font-size:clamp(26px,3.2vw,42px); line-height:1.07; letter-spacing:-.02em; margin:0; text-wrap:balance; }
  #bp-universe .uv-title .os-accent{ color:var(--brand-accent); }

  /* Onglets univers (barre de tabs texte soulignée) */
  #bp-universe .uv-tabs{ display:flex; gap:clamp(18px,2.4vw,34px); justify-content:center; border-bottom:1.5px solid rgba(12,11,11,.13); margin:0 0 clamp(22px,2.6vw,32px); overflow-x:auto; scrollbar-width:none; }
  #bp-universe .uv-tabs::-webkit-scrollbar{ display:none; }
  #bp-universe .uv-tab{ position:relative; flex:0 0 auto; min-height:44px; display:inline-flex; align-items:center; gap:8px; padding:2px 2px 14px; border:none; background:none; cursor:pointer; font-family:var(--brand-font-title); font-weight:700; font-size:clamp(15px,1.7vw,17px); color:rgba(12,11,11,.5); transition:color .2s ease; }
  #bp-universe .uv-tab:hover{ color:#0C0B0B; }
  #bp-universe .uv-tab:focus-visible{ outline:3px solid var(--brand-accent); outline-offset:3px; border-radius:6px; }
  #bp-universe .uv-tab .uv-tab-dot{ width:9px; height:9px; border-radius:2px; background:var(--brand-accent); opacity:.38; transition:opacity .2s ease; }
  #bp-universe .uv-tab::after{ content:""; position:absolute; left:0; right:0; bottom:-1.5px; height:3px; border-radius:3px 3px 0 0; background:var(--brand-accent); transform:scaleX(0); transition:transform .28s cubic-bezier(.22,1,.36,1); }
  #bp-universe .uv-tab[aria-selected="true"]{ color:#0C0B0B; }
  #bp-universe .uv-tab[aria-selected="true"] .uv-tab-dot{ opacity:1; }
  #bp-universe .uv-tab[aria-selected="true"]::after{ transform:scaleX(1); }

  /* Panneau = carousel produits */
  #bp-universe .uv-panel[hidden]{ display:none; }
  #bp-universe .uv-panel.is-active{ animation:uvIn .34s cubic-bezier(.22,1,.36,1); }
  @keyframes uvIn{ from{ opacity:0; transform:translateY(10px); } to{ opacity:1; transform:none; } }
  #bp-universe .uv-carousel{ position:relative; }
  #bp-universe .uv-viewport{ overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth; scrollbar-width:none; margin:0 -4px; padding:4px; }
  #bp-universe .uv-viewport::-webkit-scrollbar{ display:none; }
  #bp-universe .uv-track{ display:flex; gap:16px; }
  #bp-universe .uv-card, #bp-universe .uv-cover{ flex:0 0 calc((100% - 48px)/4); scroll-snap-align:start; }

  /* Carte "cover" d'univers : le visuel généré représente l'univers (PAS un produit, pas de prix) */
  #bp-universe .uv-cover{ position:relative; display:block; border-radius:10px; overflow:hidden; aspect-ratio:3/4; text-decoration:none; background:color-mix(in srgb, var(--acc) 22%, #F5EDE0); box-shadow:0 16px 32px -22px rgba(12,11,11,.5); transition:transform .22s ease; }
  #bp-universe .uv-cover:hover{ transform:translateY(-4px); }
  #bp-universe .uv-cover:focus-visible{ outline:3px solid var(--acc); outline-offset:3px; }
  #bp-universe .uv-cover img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  #bp-universe .uv-cover-lbl{ position:absolute; inset:0; z-index:2; display:flex; flex-direction:column; justify-content:flex-end; gap:3px; padding:16px; background:linear-gradient(to top, rgba(12,11,11,.82) 0%, rgba(12,11,11,.22) 50%, rgba(12,11,11,.12) 100%); }
  #bp-universe .uv-cover-kick{ font-family:var(--brand-font-display); font-size:10px; letter-spacing:.05em; text-transform:uppercase; color:var(--acc); }
  #bp-universe .uv-cover-name{ font-family:var(--brand-font-title); font-weight:800; font-size:clamp(18px,2vw,22px); color:#F5EDE0; line-height:1.05; }
  #bp-universe .uv-cover-go{ margin-top:5px; font-family:var(--brand-font-body); font-weight:700; font-size:13px; color:#F5EDE0; display:inline-flex; align-items:center; gap:6px; }
  #bp-universe .uv-cover-go span{ transition:transform .2s ease; }
  #bp-universe .uv-cover:hover .uv-cover-go span{ transform:translateX(4px); }

  /* Carte produit */
  #bp-universe .uv-card{ display:flex; flex-direction:column; }
  #bp-universe .uv-media{ position:relative; border-radius:10px; overflow:hidden; aspect-ratio:3/4; background-color:color-mix(in srgb, var(--acc) 13%, #F5EDE0); background-image:radial-gradient(circle, color-mix(in srgb, var(--acc) 55%, transparent) 29%, transparent 32%); background-size:16px 16px; background-position:center; border:0; transition:transform .22s ease, box-shadow .22s ease; }
  #bp-universe .uv-card:hover .uv-media{ transform:translateY(-4px); box-shadow:0 16px 30px -20px rgba(12,11,11,.5); }
  #bp-universe .uv-media-link{ position:absolute; inset:0; z-index:1; }
  #bp-universe .uv-media-link:focus-visible{ outline:3px solid var(--brand-accent); outline-offset:3px; border-radius:10px; }
  #bp-universe .uv-badge{ position:absolute; top:10px; left:10px; z-index:2; font-family:var(--brand-font-display); font-size:9px; letter-spacing:.02em; text-transform:uppercase; color:#0C0B0B; background:#FFFDF8; padding:5px 8px; border-radius:999px; box-shadow:0 2px 6px rgba(12,11,11,.16); }
  #bp-universe .uv-heart{ position:absolute; top:8px; right:8px; z-index:2; width:30px; height:30px; padding:0; border:none; border-radius:50%; background:rgba(255,253,248,.92); color:#0C0B0B; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:color .2s ease, transform .15s ease; }
  #bp-universe .uv-heart:hover{ transform:scale(1.1); }
  #bp-universe .uv-heart:focus-visible{ outline:3px solid var(--brand-accent); outline-offset:2px; }
  #bp-universe .uv-heart svg{ width:15px; height:15px; fill:none; stroke:currentColor; stroke-width:2; }
  #bp-universe .uv-heart.is-liked{ color:var(--brand-accent); }
  #bp-universe .uv-heart.is-liked svg{ fill:var(--brand-accent); stroke:var(--brand-accent); }
  #bp-universe .uv-pname{ font-family:var(--brand-font-title); font-weight:700; font-size:15px; color:#0C0B0B; line-height:1.15; margin:12px 2px 3px; }
  #bp-universe .uv-price{ font-family:var(--brand-font-body); font-weight:800; font-size:14px; color:#0C0B0B; margin:0 2px; }
