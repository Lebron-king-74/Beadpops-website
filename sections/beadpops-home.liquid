  /* ===== SECTION 10 : TABLEAU DE COMPARAISON (BeadPops vs les autres) ===== */
  #bp-compare{ background-color:#F5EDE0; background-image:linear-gradient(rgba(245,237,224,.82),rgba(245,237,224,.88)),url('{{ 'bp-bg-light-desktop.webp' | asset_url }}'); background-size:cover; background-position:center; color:#0C0B0B; padding:clamp(38px,4.5vw,72px) 0; }
  #bp-compare .cx-wrap{ width:min(calc(100% - (2 * var(--lp-gutter))),var(--lp-content-max)); margin-inline:auto; }
  #bp-compare .cx-head{ text-align:center; max-width:720px; margin:0 auto clamp(24px,3vw,38px); }
  #bp-compare .cx-title{ font-family:var(--brand-font-title); font-weight:800; color:#0C0B0B; font-size:clamp(24px,3.1vw,40px); line-height:1.08; letter-spacing:-.02em; margin:0; text-wrap:balance; }
  #bp-compare .cx-title .os-accent{ color:var(--brand-accent); }
  #bp-compare .cx-sub{ font-family:var(--brand-font-body); color:#6B5E4E; font-size:clamp(14px,1.2vw,16px); line-height:1.5; margin:12px 0 0; }
  #bp-compare .cx-board{ max-width:1240px; margin-inline:auto; border:1px solid rgba(12,11,11,.14); border-radius:8px; overflow:hidden; box-shadow:0 26px 54px -38px rgba(12,11,11,.55); }
  #bp-compare .cx-board-head,#bp-compare .cx-row{ display:grid; grid-template-columns:minmax(150px,.58fr) minmax(0,1fr) minmax(0,1fr); }
  #bp-compare .cx-board-head{ min-height:78px; }
  #bp-compare .cx-corner,#bp-compare .cx-brand,#bp-compare .cx-label,#bp-compare .cx-value{ display:flex; align-items:center; }
  #bp-compare .cx-corner{ padding:18px 20px; background:#E9E3D6; color:#776A59; font-family:var(--brand-font-display); font-size:10px; line-height:1.25; letter-spacing:.08em; text-transform:uppercase; }
  #bp-compare .cx-brand{ padding:18px 22px; font-family:var(--brand-font-title); font-size:clamp(19px,1.8vw,25px); font-weight:800; }
  #bp-compare .cx-brand.us{ justify-content:space-between; gap:16px; background:#161412; color:#F5EDE0; }
  #bp-compare .cx-brand.us .pop{ color:var(--brand-accent); }
  #bp-compare .cx-brand.them{ background:#DED5C7; color:#51483E; }
  #bp-compare .cx-tag{ flex:none; background:var(--brand-accent); color:#0C0B0B; font-family:var(--brand-font-display); font-size:9px; letter-spacing:.05em; text-transform:uppercase; padding:5px 9px; border-radius:3px; }
  #bp-compare .cx-row{ border-top:1px solid rgba(12,11,11,.12); }
  #bp-compare .cx-label{ padding:17px 20px; background:#F5EDE0; color:#0C0B0B; font-family:var(--brand-font-title); font-size:14px; font-weight:800; line-height:1.25; }
  #bp-compare .cx-value{ gap:11px; padding:17px 22px; font-family:var(--brand-font-body); font-size:14.5px; line-height:1.35; }
  #bp-compare .cx-value.us{ background:#161412; color:#F5EDE0; }
  #bp-compare .cx-value.them{ background:#EEE7DB; color:#655A4D; }
  #bp-compare .cx-ic{ flex:none; width:22px; height:22px; border-radius:4px; display:inline-flex; align-items:center; justify-content:center; font-size:12px; font-weight:800; }
  #bp-compare .cx-value.us .cx-ic{ background:var(--brand-accent); color:#0C0B0B; }
  #bp-compare .cx-value.them .cx-ic{ border:1px solid rgba(12,11,11,.16); color:#827564; }

  @media (max-width:700px){
    #bp-compare .cx-head{ margin-bottom:24px; }
