  /* Avis : guillemet monumental et ponctuation graphique */
  #bp-reviews{ background:linear-gradient(180deg,#F5EDE0 0%,#EEE3D3 100%); }
  #bp-reviews::before{ content:"\201C"; position:absolute; z-index:0; left:-18px; top:5%; font-family:var(--brand-font-title); font-size:clamp(180px,20vw,320px); font-weight:800; line-height:1; color:color-mix(in srgb,var(--brand-accent) 6%,transparent); pointer-events:none; }
