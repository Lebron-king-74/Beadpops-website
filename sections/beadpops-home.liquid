      <div class="rv-track" id="rv-track">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% assign review_rating = block.settings.rating | plus: 0 %}
            <article class="rv-card" {{ block.shopify_attributes }}>
              <div class="rv-media">
                {% if block.settings.photo != blank %}
                  {{ block.settings.photo | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 821px) 29vw, 82vw' }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
              <div class="rv-copy">
                <div class="rv-stars" aria-label="{{ review_rating }} sur 5">
                  <span aria-hidden="true">{% for star in (1..5) %}{% if star <= review_rating %}★{% else %}☆{% endif %}{% endfor %}</span>
                </div>
                <blockquote class="rv-quote">« {{ block.settings.quote | escape }} »</blockquote>
                <div class="rv-author">
                  <span class="rv-name">{{ block.settings.author | escape }}{% if block.settings.location != blank %} · {{ block.settings.location | escape }}{% endif %}</span>
                  {% if block.settings.verified %}<span class="rv-badge">Achat vérifié</span>{% endif %}
                </div>
              </div>
            </article>
          {% endfor %}
        {% elsif request.design_mode %}
          {% for preview_index in (1..3) %}
            <article class="rv-card">
              <div class="rv-media">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
              <div class="rv-copy">
                <div class="rv-stars"><span aria-hidden="true">★★★★★</span><span class="rv-placeholder">Aperçu</span></div>
                <blockquote class="rv-quote">« Ajoutez ici un avis client vérifié et sa photo. »</blockquote>
                <div class="rv-author"><span class="rv-name">Prénom et ville</span><span class="rv-badge">Avis à renseigner</span></div>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
    </div>
    <div class="rv-controls lp-wrap">
      <button class="rv-arrow rv-prev" type="button" aria-label="Avis précédent">&larr;</button>
      <div class="rv-dots" id="rv-dots" aria-label="Choisir un avis"></div>
      <button class="rv-arrow rv-next" type="button" aria-label="Avis suivant">&rarr;</button>
    </div>
  </div>
</section>
