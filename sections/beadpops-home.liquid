<section id="bp-reviews">
  <div class="rv-head lp-wrap">
    <div class="rv-eyebrow">{{ section.settings.reviews_eyebrow | escape }}</div>
    <h2 class="rv-title">{{ section.settings.reviews_title | escape }} <span class="os-accent">{{ section.settings.reviews_title_accent | escape }}</span></h2>
    <div class="rv-summary">
      <span class="rv-summary-stars" aria-hidden="true">★★★★★</span>
      <span class="rv-summary-label">{{ section.settings.reviews_summary | escape }}</span>
    </div>
  </div>
