<script>
(function initBeadPopsHome(){
  var root = document.getElementById('beadpops-home-{{ section.id }}');
  if(!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';
/* Avis clients : swipe natif, centrage de la carte active et commandes clavier */
(function(){
  var viewport = document.getElementById('rv-viewport');
  var track = document.getElementById('rv-track');
  if(!viewport || !track) return;
  var cards = track.querySelectorAll('.rv-card');
  var N = cards.length;
  if(!N) return;
  var dotsWrap = document.getElementById('rv-dots');
  var idx = N > 1 ? 1 : 0, dots = [], ticking = false;
  for(var i=0;i<N;i++){ (function(k){ var d=document.createElement('button'); d.type='button'; d.className='rv-dot'; d.setAttribute('aria-label','Avis '+(k+1)); d.addEventListener('click',function(){ go(k); }); dotsWrap.appendChild(d); dots.push(d); })(i); }
  function sync(){
    var center = viewport.scrollLeft + viewport.clientWidth / 2;
    var nearest = 0, distance = Infinity;
    for(var i=0;i<N;i++){
      var cardCenter = cards[i].offsetLeft + cards[i].offsetWidth / 2;
      var currentDistance = Math.abs(cardCenter - center);
      if(currentDistance < distance){ distance = currentDistance; nearest = i; }
    }
    idx = nearest;
    for(var j=0;j<N;j++){
      cards[j].classList.toggle('is-active', j===idx);
      dots[j].classList.toggle('is-active', j===idx);
      dots[j].setAttribute('aria-current', j===idx ? 'true' : 'false');
    }
    ticking = false;
  }
  function go(i, instant){
    idx = Math.max(0,Math.min(N-1,i));
    var left = cards[idx].offsetLeft - (viewport.clientWidth - cards[idx].offsetWidth) / 2;
    viewport.scrollTo({ left:left, behavior:instant ? 'auto' : 'smooth' });
    sync();
  }
  viewport.addEventListener('scroll',function(){ if(!ticking){ ticking=true; requestAnimationFrame(sync); } },{passive:true});
  var prev = document.querySelector('#bp-reviews .rv-prev'), next = document.querySelector('#bp-reviews .rv-next');
  if(prev) prev.addEventListener('click', function(){ go(idx-1); });
  if(next) next.addEventListener('click', function(){ go(idx+1); });
  window.addEventListener('resize',function(){ go(idx,true); },{passive:true});
  requestAnimationFrame(function(){ go(idx,true); });
})();

/* Raisons : accordeon un-seul-ouvert (mobile + desktop) + synchro image preview (desktop) */
(function(){
  var R = document.querySelectorAll('#bp-reasons .reason');
  if(!R.length) return;
  var label = document.querySelector('#bp-reasons .rp-label');
  var frame = document.querySelector('#bp-reasons .rp-frame');
  function activate(d){
    R.forEach(function(o){ if(o!==d){ o.open=false; } });
    var n = d.querySelector('.reason-name');
    if(label && n){ label.textContent = n.textContent; }
    var src = d.getAttribute('data-img');
    var vsrc = d.getAttribute('data-video');
    if(frame){
      var img = frame.querySelector('img');
      if(src){ if(!img){ img=document.createElement('img'); img.alt=''; frame.appendChild(img); } img.src=src; img.style.display='block'; }
      else if(img){ img.style.display='none'; }
      var vid = frame.querySelector('video');
      if(vsrc){
        if(!vid){
          vid=document.createElement('video');
          vid.muted=true; vid.loop=true; vid.playsInline=true; vid.autoplay=true;
          vid.setAttribute('muted',''); vid.setAttribute('playsinline',''); vid.setAttribute('preload','metadata');
          frame.appendChild(vid);
        }
        if(vid.getAttribute('src')!==vsrc){ vid.src=vsrc; }
        vid.style.display='block';
        var p=vid.play(); if(p&&p.catch){ p.catch(function(){}); }
      }
      else if(vid){ vid.pause(); vid.style.display='none'; }
    }
  }
  R.forEach(function(d){ d.addEventListener('toggle', function(){ if(d.open){ activate(d); } }); });
  R.forEach(function(d,i){ d.open = (i===0); });
  activate(R[0]);
})();

/* Starter Kit : explorateur interactif (clic cercle -> fiche element) */
(function(){
  var KIT = [
    { em:"🌈", badge:"7 200 beads", name:"24 couleurs de beads", desc:"24 sachets × 300 beads = 7 200 beads pour donner vie à tes designs (et te faire plaisir sur les détails)." },
    { em:"⚫", badge:"2 000 beads", name:"Beads noir + blanc", desc:"1 000 noires + 1 000 blanches, pour des contours nets et un rendu propre." },
    { em:"🖊️", badge:"", name:"Stylo ramasse-beads", desc:"Pour placer vite, propre, et sans t'énerver." },
    { em:"🔍", badge:"", name:"Pince de précision", desc:"Pour les mini zones et les détails qui font la diff." },
    { em:"🧺", badge:"", name:"Plateau à beads", desc:"Pour trier, verser, et garder ton espace clean pendant que tu crées." },
    { em:"🧩", badge:"", name:"Plaque connectable (pegboard)", desc:"Base de création, avec extension possible si tu veux voir plus grand." },
    { em:"📄", badge:"", name:"Papiers de repassage", desc:"Pour fixer ton pixel art (et le garder nickel)." },
    { em:"🩹", badge:"", name:"Ruban (scotch)", desc:"Pour maintenir et retourner sans stress avant de repasser." }
  ];
  var detail = document.getElementById('kit-detail');
  if(!detail) return;
  var btns = document.querySelectorAll('#bp-offer .kit-btn');
  var badgeEl = detail.querySelector('.kit-badge'),
      nameEl = detail.querySelector('.kit-name'),
      descEl = detail.querySelector('.kit-desc');
  var cur = 0;
  function render(i){
    var n = KIT.length; i = ((i % n) + n) % n; cur = i;
    var k = KIT[i]; if(!k) return;
    badgeEl.textContent = k.badge; badgeEl.style.display = k.badge ? 'inline-block' : 'none';
    nameEl.textContent = k.name; descEl.textContent = k.desc;
    for(var j=0;j<btns.length;j++){ var on = j===i; btns[j].classList.toggle('is-active', on); btns[j].setAttribute('aria-selected', on?'true':'false'); }
  }
  for(var i=0;i<btns.length;i++){ (function(idx){ btns[idx].addEventListener('click', function(){ render(idx); }); })(i); }
  var prevBtn = document.querySelector('#bp-offer .kit-prev'), nextBtn = document.querySelector('#bp-offer .kit-next');
  if(prevBtn) prevBtn.addEventListener('click', function(){ render(cur-1); });
