    #bp-compare{ background-image:linear-gradient(180deg,rgba(245,237,224,.97) 0%,rgba(245,237,224,.93) 32%,rgba(245,237,224,.90) 100%),url('{{ 'bp-bg-light-mobile.webp' | asset_url }}'); background-size:100% auto; background-position:center top; background-repeat:no-repeat; }
  }

  /* ===== SECTION 12 : LA CREATION (mur d'inspiration, visuels de creations, fond sombre) ===== */
  #bp-gallery{ background:radial-gradient(ellipse at 50% 0%,color-mix(in srgb,var(--brand-accent) 9%,transparent) 0%,transparent 34%),linear-gradient(180deg,#0C0B0B 0%,#12100F 100%); color:var(--brand-text); padding:clamp(38px,4.5vw,72px) 0; }
  #bp-gallery .gal-head{ text-align:center; max-width:640px; margin:0 auto clamp(26px,3.2vw,42px); }
  #bp-gallery .gal-title{ font-family:var(--brand-font-title); font-weight:800; color:#F5EDE0; font-size:clamp(28px,3.6vw,50px); line-height:1.04; letter-spacing:-.02em; margin:0; text-wrap:balance; }
  #bp-gallery .gal-title .os-accent{ color:var(--brand-accent); }
  #bp-gallery .gal-sub{ font-family:var(--brand-font-body); color:color-mix(in srgb, var(--brand-text) 80%, transparent); font-size:clamp(14px,1.3vw,17px); line-height:1.55; margin:14px auto 0; max-width:50ch; }
  #bp-gallery .gal-grid{ columns:4; column-gap:14px; }
  #bp-gallery .gal-item{ break-inside:avoid; margin:0 0 14px; border-radius:8px; overflow:hidden; position:relative; display:flex; align-items:center; justify-content:center; background:color-mix(in srgb, var(--brand-accent) 8%, var(--brand-surface)); border:0; color:color-mix(in srgb, var(--brand-text) 28%, transparent); transition:transform .25s ease; }
  #bp-gallery .gal-item:hover{ transform:translateY(-4px); border-color:color-mix(in srgb, var(--brand-accent) 55%, transparent); }
  #bp-gallery .gal-item svg{ width:38px; height:32px; }
  #bp-gallery .gal-item img{ width:100%; height:100%; object-fit:cover; display:block; }
  #bp-gallery .gal-item.t1{ aspect-ratio:4/5; } #bp-gallery .gal-item.t2{ aspect-ratio:1/1; } #bp-gallery .gal-item.t3{ aspect-ratio:3/4; } #bp-gallery .gal-item.t4{ aspect-ratio:5/4; }
  @media (min-width:1280px){ #bp-gallery .gal-grid{ columns:5; column-gap:12px; } #bp-gallery .gal-item{ margin-bottom:12px; } }
  @media (max-width:900px){ #bp-gallery .gal-grid{ columns:3; } }
  @media (max-width:600px){ #bp-gallery .gal-grid{ columns:2; column-gap:10px; } #bp-gallery .gal-item{ margin-bottom:10px; } }

  /* ===== FOOTER ===== */
  #bp-footer{ background:linear-gradient(180deg,#0C0B0B 0%,#12100F 100%); color:var(--brand-text); padding:clamp(44px,5vw,72px) 0 clamp(24px,3vw,30px); border-top:1px solid color-mix(in srgb, var(--brand-text) 10%, transparent); }
  #bp-footer .ft-top{ display:grid; grid-template-columns:1.5fr 1fr 1fr 1fr; gap:clamp(24px,3vw,44px); }
  #bp-footer .ft-logo{ font-family:var(--brand-font-display); font-size:20px; letter-spacing:.02em; color:var(--brand-text); }
  #bp-footer .ft-logo .pop{ color:var(--brand-accent); }
  #bp-footer .ft-tag{ font-family:var(--brand-font-body); color:color-mix(in srgb, var(--brand-text) 68%, transparent); font-size:14px; line-height:1.55; margin:14px 0 18px; max-width:34ch; }
  #bp-footer .ft-social{ display:flex; gap:10px; }
  #bp-footer .ft-social a{ width:44px; height:44px; border-radius:8px; border:1px solid color-mix(in srgb, var(--brand-text) 14%, transparent); display:flex; align-items:center; justify-content:center; color:var(--brand-text); text-decoration:none; transition:background .2s ease, color .2s ease, border-color .2s ease; }
  #bp-footer .ft-social a:hover{ background:var(--brand-accent); color:var(--brand-bg); border-color:var(--brand-accent); }
  #bp-footer .ft-social a:focus-visible{ outline:3px solid var(--brand-accent); outline-offset:2px; }
  #bp-footer .ft-social svg{ width:18px; height:18px; }
  #bp-footer .ft-col h4{ font-family:var(--brand-font-title); font-weight:800; font-size:12.5px; letter-spacing:.03em; text-transform:uppercase; color:var(--brand-text); margin:0 0 14px; }
  #bp-footer .ft-col ul{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px; }
  #bp-footer .ft-col a{ font-family:var(--brand-font-body); font-size:14px; color:color-mix(in srgb, var(--brand-text) 70%, transparent); text-decoration:none; transition:color .2s ease; }
  #bp-footer .ft-col a:hover{ color:var(--brand-accent); }
  #bp-footer .ft-bottom{ display:flex; align-items:center; justify-content:space-between; gap:14px 18px; flex-wrap:wrap; margin-top:clamp(30px,3.6vw,44px); padding-top:20px; border-top:1px solid color-mix(in srgb, var(--brand-text) 10%, transparent); }
  #bp-footer .ft-copy{ font-family:var(--brand-font-body); font-size:12.5px; color:var(--brand-text-muted); }
