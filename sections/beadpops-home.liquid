    #bp-reviews .rv-card{ display:grid; height:auto; grid-template-columns:minmax(112px,38%) minmax(0,1fr); grid-template-areas:"media quote" "media author" "ba ba"; gap:10px 14px; align-items:stretch; padding:14px; }
