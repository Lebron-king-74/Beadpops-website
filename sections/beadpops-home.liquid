  #bp-gallery{ background:linear-gradient(180deg,#0C0B0B 0%,#161412 100%); }
  #bp-gallery::before{ content:""; position:absolute; z-index:0; inset:0 auto 0 0; width:min(10vw,140px); background:conic-gradient(from 90deg at 50% 50%,color-mix(in srgb,var(--brand-accent) 7%,transparent) 25%,transparent 0 50%,color-mix(in srgb,var(--brand-text) 4%,transparent) 0 75%,transparent 0); background-size:48px 48px; -webkit-mask-image:linear-gradient(90deg,rgba(12,11,11,.65),transparent); mask-image:linear-gradient(90deg,rgba(12,11,11,.65),transparent); pointer-events:none; }
  #bp-gallery::after{ display:none; }

  /* Footer : ligne d'horizon en pixels, volontairement plus calme */
  #bp-footer{ background:linear-gradient(180deg,#0C0B0B 0%,#161412 100%); }
  #bp-footer::before{ content:""; position:absolute; z-index:0; right:0; top:0; width:min(42vw,640px); height:6px; background:linear-gradient(90deg,transparent 0 12%,color-mix(in srgb,var(--brand-accent) 30%,transparent) 12% 28%,transparent 28% 38%,var(--brand-accent) 38% 61%,transparent 61% 74%,color-mix(in srgb,var(--brand-text) 18%,transparent) 74% 100%); pointer-events:none; }
  #bp-footer::after{ display:none; }

  /* Hierarchie des actions : achat, preuve, navigation */
  #os-hero .os-hero-cta{ border-radius:6px; background:var(--brand-accent); color:#0C0B0B; box-shadow:0 4px 0 #7A2A0A; transition:transform .16s ease,box-shadow .16s ease,background .2s ease; }
  #os-hero .os-hero-cta:hover{ transform:translateY(-2px); box-shadow:0 6px 0 #7A2A0A; }
  #bp-offer .offer-cta{ border-radius:6px; background:#0C0B0B; color:#F5EDE0; box-shadow:0 4px 0 #C23D08; }
  #bp-offer .offer-cta:hover{ background:#161412; box-shadow:0 6px 0 #C23D08; }
  #bp-reviews .rv-cta{ border-radius:6px; background:#F5EDE0; background-image:none; color:#0C0B0B; border:2px solid #0C0B0B; box-shadow:0 3px 0 #C9A87C; }
  #bp-reviews .rv-cta:hover{ background:#0C0B0B; border-color:#0C0B0B; color:#F5EDE0; }
  #os-hero .os-hero-cta:active{ transform:translateY(2px); box-shadow:0 2px 0 #7A2A0A; }
  #bp-offer .offer-cta:active{ transform:translateY(2px); box-shadow:0 2px 0 #C23D08; }
  #bp-reviews .rv-cta:active{ transform:translateY(2px); box-shadow:0 1px 0 #C9A87C; }

  /* Plaque CTA a deux encoches, inspiree des pixels poses */
  #os-hero .os-hero-cta,#bp-offer .offer-cta,#bp-reviews .rv-cta,.sticky-cta .sc-btn{ border-radius:0; clip-path:polygon(0 0,calc(100% - 10px) 0,calc(100% - 10px) 5px,100% 5px,100% 100%,10px 100%,10px calc(100% - 5px),0 calc(100% - 5px)); }

  /* Fleche pixel : meme vocabulaire, contraste adapte au role */
  #os-hero .os-hero-cta,#bp-offer .offer-cta,#bp-reviews .rv-cta{ display:inline-flex; align-items:center; gap:12px; }
  #os-hero .os-hero-cta .arr,#bp-offer .offer-cta .arr,#bp-reviews .rv-cta .arr,.sticky-cta .sc-btn .arr{ flex:none; width:23px; height:23px; display:inline-grid; place-items:center; border-radius:3px; font-family:var(--brand-font-display); font-size:11px; line-height:1; }
  #os-hero .os-hero-cta .arr{ background:#0C0B0B; color:#F5EDE0; }
  #bp-offer .offer-cta .arr{ background:var(--brand-accent); color:#0C0B0B; }
  #bp-reviews .rv-cta .arr{ background:#0C0B0B; color:#F5EDE0; }
  #bp-reviews .rv-cta:hover .arr{ background:var(--brand-accent); color:#0C0B0B; }
  .sticky-cta .sc-btn .arr{ background:#0C0B0B; color:#F5EDE0; }

  /* Controles de carrousel : touches pixel, pas de pastilles generiques */
  #bp-universe .uv-arrow,#bp-offer .kit-arrow,#bp-create .cr-arrow,#bp-reviews .rv-arrow{ border-radius:5px; font-family:var(--brand-font-display); }
  #bp-universe .uv-arrow{ background:#0C0B0B; color:#F5EDE0; border-color:#0C0B0B; box-shadow:0 3px 0 #C23D08; }
  #bp-offer .kit-arrow{ background:#F5EDE0; color:#0C0B0B; border-color:color-mix(in srgb,#0C0B0B 18%,transparent); box-shadow:none; }
  #bp-create .cr-arrow{ background:#F5EDE0; color:#0C0B0B; box-shadow:0 3px 0 #C23D08; }
  #bp-reviews .rv-arrow{ background:#F5EDE0; color:#0C0B0B; box-shadow:0 3px 0 #C9A87C; }

  /* Cartes : rayon court et constant pour eviter l'effet composant generique */
  #bp-universe .uv-cover,#bp-universe .uv-media,#bp-how .hw-media,#bp-reasons .reason,#bp-reasons .reason-media,#bp-reviews .rv-card,#bp-reviews .rv-ph,#bp-compare .cx-board,#bp-gallery .gal-item{ border-radius:6px; }

  /* Trois raccords courts en dents pixel, seulement aux ruptures fortes */
  #os-hero::after,#bp-reviews::after{ display:none; }
  .bp-seam{ --seam-step:30px; position:relative; z-index:3; height:10px; margin-block:-1px; overflow:hidden; background:var(--seam-to); }
  .bp-seam::before{ content:""; position:absolute; inset:0; background:linear-gradient(to bottom,var(--seam-from) 0 5px,transparent 5px),linear-gradient(90deg,var(--seam-from) 0 50%,transparent 50%) 0 5px/var(--seam-step) 5px repeat-x; }
  .bp-seam--dark-light{ --seam-from:#0C0B0B; --seam-to:#F5EDE0; }
  .bp-seam--light-dark{ --seam-from:#F5EDE0; --seam-to:#0C0B0B; }
  .bp-seam--light-pop{ --seam-from:#F5EDE0; --seam-to:#FF5C1A; }

  @media (max-width:700px){
    .bp-seam{ --seam-step:24px; height:8px; }
    .bp-seam::before{ background:linear-gradient(to bottom,var(--seam-from) 0 4px,transparent 4px),linear-gradient(90deg,var(--seam-from) 0 50%,transparent 50%) 0 4px/var(--seam-step) 4px repeat-x; }
    #os-hero::before{ width:230px; right:-138px; top:30%; opacity:.7; }
    #bp-universe::before{ inset:48% 0 0; background-size:22px 22px; -webkit-mask-image:linear-gradient(90deg,rgba(12,11,11,.72),transparent 42%,rgba(12,11,11,.4)); mask-image:linear-gradient(90deg,rgba(12,11,11,.72),transparent 42%,rgba(12,11,11,.4)); }
    #bp-modes::before{ right:-18px; bottom:7%; width:26px; height:58px; box-shadow:-38px -34px 0 color-mix(in srgb,var(--brand-accent) 13%,transparent),-76px -76px 0 color-mix(in srgb,var(--brand-accent) 7%,transparent); }
    #bp-how::before{ right:-34px; bottom:5%; width:44px; opacity:.72; }
    #bp-reviews::before{ left:-48px; top:2%; font-size:200px; opacity:.65; }
    #bp-forwho::before{ top:-66px; right:-74px; width:160px; border-width:24px; opacity:.75; }
    #bp-gallery::before{ width:18vw; background-size:40px 40px; opacity:.7; }
    #bp-footer::before{ width:72vw; }
  }
  @media (prefers-reduced-motion:reduce){
    #os-hero .os-tf-lbl,#os-hero .os-tf-arrow{ animation:none; }
    .bp-marquee.is-running .bp-marquee-track{ animation:none; }
  }

  /* Sticky CTA mobile : bouton d'achat persistant en bas d'écran */
  .sticky-cta{ display:none; }
  @media (max-width:760px){
    .sticky-cta{ display:flex; position:fixed; left:0; right:0; bottom:0; z-index:50; align-items:center; justify-content:space-between; gap:12px; padding:11px 16px calc(11px + env(safe-area-inset-bottom, 0px)); background:var(--brand-surface); border-top:1px solid color-mix(in srgb, var(--brand-accent) 32%, transparent); text-decoration:none; box-shadow:0 -8px 24px -12px rgba(0,0,0,.7); }
    .sticky-cta .sc-price{ display:flex; flex-direction:column; line-height:1.05; }
    .sticky-cta .sc-amount{ font-family:var(--brand-font-title); font-weight:800; font-size:18px; color:var(--brand-text); }
    .sticky-cta .sc-note{ font-family:var(--brand-font-body); font-size:10px; color:var(--brand-text-muted); }
    .sticky-cta .sc-btn{ flex:1; max-width:60%; display:inline-flex; align-items:center; justify-content:center; gap:8px; background:var(--brand-accent); color:#0C0B0B; font-family:var(--brand-font-title); font-weight:800; font-size:15px; padding:13px 18px; border-radius:6px; box-shadow:0 3px 0 #7A2A0A; }
    .sticky-cta:focus-visible{ outline:3px solid var(--brand-accent); outline-offset:-3px; }
    body{ padding-bottom:66px; }
  }
  @media (prefers-reduced-motion:reduce){ .sticky-cta{ transition:none; } }

  /* Avis clients : galerie éditoriale inspirée des cartes UGC, adaptée à BeadPops */
  #bp-reviews{ padding:clamp(54px,6vw,92px) 0 clamp(48px,5vw,76px); background:linear-gradient(180deg,#F5EDE0 0%,#EEE3D3 100%); }
  #bp-reviews::before{ content:""; left:0; top:0; width:100%; height:100%; background:radial-gradient(circle at 8% 18%,color-mix(in srgb,var(--brand-accent) 8%,transparent) 0 2px,transparent 2.5px); background-size:30px 30px; -webkit-mask-image:linear-gradient(90deg,rgba(12,11,11,.65),transparent 24%); mask-image:linear-gradient(90deg,rgba(12,11,11,.65),transparent 24%); opacity:.48; }
  #bp-reviews .rv-head{ max-width:720px; margin:0 auto clamp(28px,3.6vw,48px); padding-inline:20px; }
  #bp-reviews .rv-eyebrow{ display:inline-flex; margin:0 0 13px; }
  #bp-reviews .rv-title{ font-size:clamp(32px,4.4vw,60px); line-height:.98; }
  #bp-reviews .rv-summary{ display:flex; align-items:center; justify-content:center; gap:10px; margin-top:18px; color:#0C0B0B; font-family:var(--brand-font-body); font-size:clamp(13px,1.2vw,15px); }
  #bp-reviews .rv-summary-stars{ color:var(--brand-accent); letter-spacing:2px; line-height:1; }
  #bp-reviews .rv-summary-label{ font-weight:650; }
  #bp-reviews .rv-carousel{ position:relative; width:100%; }
  #bp-reviews .rv-viewport{ height:auto; overflow-x:auto; overflow-y:hidden; border-radius:0; scroll-snap-type:x mandatory; scroll-padding-inline:max(20px,calc((100vw - min(82vw,430px))/2)); overscroll-behavior-x:contain; scrollbar-width:none; -ms-overflow-style:none; }
  #bp-reviews .rv-viewport::-webkit-scrollbar{ display:none; }
  #bp-reviews .rv-track{ width:max-content; height:auto; gap:clamp(14px,1.6vw,22px); padding-inline:max(20px,calc((100vw - min(82vw,430px))/2)); transform:none!important; transition:none; }
  #bp-reviews .rv-card{ flex:0 0 min(82vw,430px); height:auto; padding:0; overflow:hidden; scroll-snap-align:center; scroll-snap-stop:always; background:#F5EDE0; border:1px solid color-mix(in srgb,#0C0B0B 16%,transparent); border-radius:6px; opacity:.56; transform:scale(.965); transform-origin:center; transition:opacity .25s ease,transform .25s ease; }
  #bp-reviews .rv-card.is-active{ opacity:1; transform:scale(1); }
  #bp-reviews .rv-media{ display:block; width:100%; aspect-ratio:4/5; min-height:0; border:0; border-radius:0; background:#E8DDCC; overflow:hidden; }
  #bp-reviews .rv-media img{ width:100%; height:100%; object-fit:cover; display:block; }
  #bp-reviews .rv-copy{ display:flex; flex-direction:column; min-height:248px; padding:clamp(20px,2.2vw,28px); }
  #bp-reviews .rv-stars{ display:block; margin:0 0 14px; font-size:15px; }
  #bp-reviews .rv-placeholder{ display:inline-flex; align-self:flex-start; margin-left:8px; color:#6B5E4E; font-family:var(--brand-font-display); font-size:9px; letter-spacing:.05em; text-transform:uppercase; }
  #bp-reviews .rv-quote{ font-family:var(--brand-font-body); font-size:clamp(16px,1.3vw,18px); line-height:1.48; font-weight:520; letter-spacing:0; text-wrap:pretty; }
  #bp-reviews .rv-author{ margin:auto 0 0; padding-top:20px; border-top:1px solid color-mix(in srgb,#0C0B0B 12%,transparent); }
  #bp-reviews .rv-name{ font-family:var(--brand-font-title); font-size:14px; font-weight:800; }
  #bp-reviews .rv-badge{ padding:0; border-radius:0; background:transparent; color:#6B5E4E; font-size:12px; }
  #bp-reviews .rv-badge::before{ content:""; width:8px; height:8px; border-radius:2px; background:var(--brand-accent); }
  #bp-reviews .rv-controls{ display:flex; align-items:center; justify-content:center; gap:18px; min-height:54px; margin-top:24px; padding-inline:20px; }
  #bp-reviews .rv-arrow{ position:static; width:44px; height:44px; flex:none; border-radius:6px; transform:none; background:#F5EDE0; border:1.5px solid #0C0B0B; color:#0C0B0B; box-shadow:3px 3px 0 #C9A87C; font-size:18px; }
  #bp-reviews .rv-arrow:hover{ background:#0C0B0B; color:#F5EDE0; transform:translate(-1px,-1px); }
  #bp-reviews .rv-dots{ min-height:0; margin:0; gap:6px; }
  #bp-reviews .rv-dot{ width:28px; height:24px; }
  #bp-reviews .rv-dot::before{ width:22px; height:3px; border-radius:1px; background:color-mix(in srgb,#0C0B0B 22%,transparent); }
  #bp-reviews .rv-dot.is-active::before{ width:22px; background:#0C0B0B; }

  @media (min-width:821px){
    #bp-reviews .rv-viewport{ scroll-padding-inline:max(32px,calc((100vw - min(29vw,430px))/2)); }
