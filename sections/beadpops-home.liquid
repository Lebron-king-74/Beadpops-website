    #bp-compare .cx-board-head{ display:none; }
    #bp-compare .cx-row{ display:grid; grid-template-columns:1fr; margin-bottom:12px; border:1px solid rgba(12,11,11,.14); border-radius:6px; overflow:hidden; }
