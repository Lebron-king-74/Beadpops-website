  @media (max-width:820px){ #bp-footer .ft-top{ grid-template-columns:1fr 1fr; gap:28px 24px; } #bp-footer .ft-brand{ grid-column:1 / -1; } }
  @media (max-width:520px){ #bp-footer .ft-top{ grid-template-columns:1fr; } #bp-footer .ft-col a{ display:flex; align-items:center; min-height:44px; } #bp-footer .ft-col ul{ gap:0; } #bp-footer .ft-bottom{ flex-direction:column; align-items:flex-start; } }

  /* ===== COMPOSITIONS DE FOND : un rythme propre a chaque section ===== */
  #os-hero,#bp-universe,#bp-modes,#bp-offer,#bp-reasons,#bp-create,#bp-reviews,#bp-compare,#bp-gallery,#bp-footer{ position:relative; isolation:isolate; overflow:hidden; }
  #os-hero > .lp-wrap,#bp-universe > .lp-wrap,#bp-modes > .lp-wrap,#bp-offer > .lp-wrap,#bp-reasons > .lp-wrap,#bp-create > .lp-wrap,#bp-reviews > .lp-wrap,#bp-compare > .cx-wrap,#bp-gallery > .lp-wrap,#bp-footer > #beadpops-home-{{ section.id }} .lp-wrap{ position:relative; z-index:1; }

  /* Hero : cadre pixel croppe autour de la transformation */
  #os-hero{ background:linear-gradient(112deg,#0C0B0B 0%,#0C0B0B 52%,#161412 100%); }
  #os-hero::before{ content:""; position:absolute; z-index:0; width:clamp(250px,29vw,470px); aspect-ratio:1/1; right:-7%; top:11%; border:clamp(12px,1.4vw,22px) solid color-mix(in srgb,var(--brand-accent) 10%,transparent); transform:rotate(8deg); pointer-events:none; }
  #os-hero::after{ display:none; }

  /* Univers : matrice de beads qui se densifie vers les produits */
  #bp-universe{ background:linear-gradient(155deg,#F5EDE0 0%,#F5EDE0 52%,#EDE1D0 100%); }
  #bp-universe::before{ content:""; position:absolute; z-index:0; inset:48% 0 0; background-image:radial-gradient(circle,color-mix(in srgb,var(--brand-accent) 13%,transparent) 0 2px,transparent 2.4px); background-size:26px 26px; -webkit-mask-image:linear-gradient(90deg,rgba(12,11,11,.56),transparent 24%,transparent 76%,rgba(12,11,11,.5)); mask-image:linear-gradient(90deg,rgba(12,11,11,.56),transparent 24%,transparent 76%,rgba(12,11,11,.5)); pointer-events:none; }
  #bp-universe::after{ display:none; }

  /* Niveaux : trois barres qui montent comme la difficulte */
  #bp-modes{ background:linear-gradient(180deg,#0C0B0B 0%,#161412 100%); }
  #bp-modes::before{ content:""; position:absolute; z-index:0; right:-22px; bottom:10%; width:30px; height:68px; background:color-mix(in srgb,var(--brand-accent) 13%,transparent); box-shadow:-48px -38px 0 color-mix(in srgb,var(--brand-accent) 8%,transparent),-96px -82px 0 color-mix(in srgb,var(--brand-accent) 5%,transparent); pointer-events:none; }
  #bp-modes::after{ display:none; }
  #bp-modes > #beadpops-home-{{ section.id }} .lp-wrap{ position:relative; z-index:1; }

  /* Etapes : chemin d'assemblage et trois points de progression */
  #bp-how{ overflow-x:clip; background:linear-gradient(180deg,#F5EDE0 0%,#EFE4D4 100%); }
  #bp-how::before{ right:2.5%; bottom:8%; width:52px; border:1px solid color-mix(in srgb,var(--brand-accent) 16%,transparent); box-shadow:-62px -50px 0 -1px color-mix(in srgb,var(--brand-accent) 10%,transparent),-124px -100px 0 -1px color-mix(in srgb,var(--brand-accent) 6%,transparent); }
  #bp-how::after{ display:none; }

  /* Starter Kit : surface calme pour lire le contenu */
  #bp-offer{ background:linear-gradient(128deg,#F5EDE0 0%,#F5EDE0 68%,#EEE3D3 100%); }
  #bp-offer::before,#bp-offer::after{ display:none; }

  /* Raisons : pegboard sombre et grand signe Pop en bordure */
  #bp-reasons{ background-color:#0C0B0B; background-image:radial-gradient(color-mix(in srgb,var(--brand-text) 6%,transparent) 1.1px,transparent 1.6px); background-size:24px 24px; }
