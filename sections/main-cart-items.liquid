{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .bp-cart-title-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  /* Séparateur entre les groupes de perles par design (voir bp_group_list plus bas) — assez
     marqué pour repérer un design d'un coup d'œil dans un panier qui en contient plusieurs. */
  .bp-cart-group-header td {
    padding-top: 3rem;
    padding-bottom: 1rem;
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.15);
  }

  .bp-cart-group-header:first-child td {
    padding-top: 0;
  }

  .bp-cart-group-header__row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.8rem 1.6rem;
  }

  .bp-cart-group-header__title {
    font-size: calc(var(--font-heading-scale) * 1.6rem);
    font-weight: 600;
  }

  .bp-cart-group-header__meta {
    opacity: 0.65;
    font-size: 1.3rem;
  }

  .bp-cart-group-header__remove {
    margin-left: auto;
    font-size: 1.3rem;
  }

  /* Lignes "perles BeadPops" (voir bp-cart-item-row.liquid, propriété de ligne _bp_design posée
     à l'ajout par shopifyCart.js) : une ligne = une seule couleur, donc pas besoin de l'espace
     généreux prévu par le thème pour un vrai produit (options, vignette 10rem, 4rem de
     padding...) — ça rendait la liste illisible dès qu'un design comptait plusieurs couleurs.
     Réduit uniquement pour ces lignes, le reste du panier (produits hors configurateur) garde
     la mise en page standard du thème. */
  @media screen and (max-width: 749px) {
    .bp-cart-item--bead {
      margin-bottom: 1.2rem;
      gap: 0.8rem;
    }
  }

  @media screen and (min-width: 750px) {
    .bp-cart-item--bead > td {
      padding-top: 1.2rem;
      padding-bottom: 1.2rem;
    }

    .bp-cart-item--bead .cart-item__media {
      width: 5rem;
    }

    .bp-cart-item--bead .cart-item__details {
      width: auto;
    }
  }

  .bp-cart-item--bead .cart-item__image {
    max-width: 5rem;
  }

  .bp-cart-item--bead .cart-item__title {
    font-size: calc(var(--font-heading-scale) * 1.1rem);
  }

  .bp-cart-item--bead .cart-item__details > * + * {
    margin-top: 0.2rem;
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<script>
  // Bouton "Retirer ces perles" d'un groupe de design (voir bp-cart-group-header__remove
  // ci-dessous) : retire en un seul appel toutes les lignes du groupe via /cart/update.js (par
  // clé de ligne, donc pas sensible aux décalages d'index qu'entraînerait un retrait ligne par
  // ligne). Volontairement indépendant du custom element CartItems du thème — un rechargement de
  // page après succès reste plus simple et fiable qu'un ré-rendu partiel, et c'est déjà le
  // comportement du lien "Vider le panier" juste au-dessus.
  document.addEventListener('click', function (event) {
    var btn = event.target.closest('.bp-cart-group-header__remove')
    if (!btn) return
    event.preventDefault()
    var keys = (btn.dataset.bpRemoveKeys || '').split(',').filter(Boolean)
    if (keys.length === 0) return
    var updates = {}
    keys.forEach(function (key) {
      updates[key] = 0
    })
    btn.disabled = true
    var originalLabel = btn.textContent
    btn.textContent = '…'
    fetch(window.routes.cart_update_url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ updates: updates }),
    })
      .then(function (res) {
        if (!res.ok) throw new Error('cart update failed')
        window.location.reload()
      })
      .catch(function () {
        btn.disabled = false
        btn.textContent = originalLabel
      })
  })
</script>

<cart-items
  class="gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}"
  view-event-payload="{{ cart | standard_event_data: 'view', context: 'page' | escape }}"
>
  <div class="page-width">
    <div class="title-wrapper-with-link">
      <h1 class="title title--primary">{{ 'sections.cart.title' | t }}</h1>
      <div class="bp-cart-title-links">
        {%- if cart != empty -%}
          <a href="{{ routes.cart_clear_url }}" class="underlined-link">Vider le panier</a>
        {%- endif -%}
        <a href="{{ routes.all_products_collection_url }}" class="underlined-link">
          {{- 'general.continue_shopping' | t -}}
        </a>
      </div>
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'general.continue_shopping' | t }}
      </a>

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            <table class="cart-items">
              <caption class="visually-hidden">
                {{ 'sections.cart.title' | t }}
              </caption>
              <thead>
                <tr>
                  <th class="caption-with-letter-spacing" colspan="2" scope="col">
                    {{ 'sections.cart.headings.product' | t }}
                  </th>
                  <th class="medium-hide large-up-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                  <th
                    class="cart-items__heading--wide cart-items__heading--quantity small-hide caption-with-letter-spacing"
                    colspan="1"
                    scope="col"
                  >
                    {{ 'sections.cart.headings.quantity' | t }}
                  </th>
                  <th class="small-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                </tr>
              </thead>

              <tbody>
                {%- comment -%}
                  Regroupe les lignes du panier par design (propriété de ligne _bp_design posée à
                  l'ajout, voir shopifyCart.js) : quand plusieurs designs sont commandés d'affilée,
                  chacun a son en-tête + son bouton "Retirer ces perles" plutôt que de tout mélanger
                  dans une liste plate où on ne sait plus quelles perles vont avec quel design.
                  bp_group_list garde l'ordre de première apparition ; '||BP-SEP||' comme séparateur
                  pour que `contains` ne matche jamais un nom de design partiellement (ex. "Chat"
                  dans "Chat Noir") lors de la détection des doublons.
                {%- endcomment -%}
                {%- liquid
                  assign bp_group_keys = '||BP-SEP||'
                  for item in cart.items
                    assign bp_name = item.properties['_bp_design']
                    if bp_name != blank
                      assign bp_needle = '||BP-SEP||' | append: bp_name | append: '||BP-SEP||'
                      unless bp_group_keys contains bp_needle
                        assign bp_group_keys = bp_group_keys | append: bp_name | append: '||BP-SEP||'
                      endunless
                    endif
                  endfor
                  assign bp_group_list = bp_group_keys | split: '||BP-SEP||'
                -%}

                {%- for bp_name in bp_group_list -%}
                  {%- unless bp_name == blank -%}
                    {%- liquid
                      assign bp_keys = ''
                      assign bp_line_count = 0
                      assign bp_qty_total = 0
                      for item in cart.items
                        if item.properties['_bp_design'] == bp_name
                          assign bp_keys = bp_keys | append: item.key | append: ','
                          assign bp_line_count = bp_line_count | plus: 1
                          assign bp_qty_total = bp_qty_total | plus: item.quantity
                        endif
                      endfor
                    -%}
                    <tr class="bp-cart-group-header">
                      <td colspan="5">
                        <div class="bp-cart-group-header__row">
                          <span class="bp-cart-group-header__title">{{ bp_name }}</span>
                          <span class="bp-cart-group-header__meta">
                            {{ bp_line_count }} couleur{% if bp_line_count > 1 %}s{% endif %} · {{ bp_qty_total }} sachet{% if bp_qty_total > 1 %}s{% endif %}
                          </span>
                          <button
                            type="button"
                            class="bp-cart-group-header__remove link"
                            data-bp-remove-keys="{{ bp_keys | strip_newlines }}"
                          >
                            Retirer ces perles
                          </button>
                        </div>
                      </td>
                    </tr>
                    {%- for item in cart.items -%}
                      {%- if item.properties['_bp_design'] == bp_name -%}
                        {%- render 'bp-cart-item-row', item: item -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endunless -%}
                {%- endfor -%}

                {%- comment -%}
                  Articles sans design associé (produits ajoutés hors configurateur, ou anciennes
                  lignes de panier créées avant ce regroupement) : rendus tels quels, à la suite des
                  groupes, sans en-tête puisqu'ils ne se rattachent à aucun design.
                {%- endcomment -%}
                {%- for item in cart.items -%}
                  {%- if item.properties['_bp_design'] == blank -%}
                    {%- render 'bp-cart-item-row', item: item -%}
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          {%- endif -%}
        </div>
      </div>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
