{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .bp-cart-title-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .bp-cart-groups {
    display: flex;
    flex-direction: column;
  }

  /* Séparateur entre les groupes de perles par design (voir bp_group_list plus bas) — assez
     marqué pour repérer un design d'un coup d'œil dans un panier qui en contient plusieurs. */
  .bp-cart-group + .bp-cart-group {
    margin-top: 2.8rem;
    padding-top: 2rem;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.15);
  }

  .bp-cart-group-header__row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem 1.6rem;
  }

  .bp-cart-group-header__title {
    font-size: calc(var(--font-heading-scale) * 1.6rem);
    font-weight: 600;
  }

  .bp-cart-group-header__meta {
    opacity: 0.65;
    font-size: 1.3rem;
  }

  .bp-cart-group-header__remove {
    margin-left: auto;
    font-size: 1.3rem;
  }

  .bp-cart-group-header__toggle {
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0.4rem;
    margin: -0.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    flex-shrink: 0;
  }

  .bp-cart-group-header__chevron {
    display: inline-block;
    font-size: 1.2rem;
    transition: transform var(--duration-short) ease;
  }

  .bp-cart-group-header__toggle[aria-expanded='true'] .bp-cart-group-header__chevron {
    transform: rotate(90deg);
  }

  /* Miniature du design dans l'en-tête de groupe (voir bp_image plus bas, posée en propriété de
     ligne _bp_design_image par shopifyCart.js/gridThumbnail.js à l'ajout) — un canvas pixel-art
     donc image-rendering: pixelated pour rester nette une fois agrandie depuis sa taille source
     (36px), plutôt que floue comme le ferait un lissage classique. */
  .bp-cart-group-header__thumb {
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 0.4rem;
    image-rendering: pixelated;
    object-fit: contain;
    flex-shrink: 0;
    align-self: center;
    background: rgb(var(--color-background));
    box-shadow: 0 0 0 0.1rem rgba(var(--color-foreground), 0.1);
  }

  /* Grille de pastilles d'un design déplié (voir bp-cart-chip.liquid) : une carte compacte par
     couleur plutôt qu'une ligne de tableau pleine largeur — se réorganise en colonnes selon la
     largeur d'écran, et se scanne visuellement par la couleur plutôt que par le texte. Le max()
     dans minmax() plafonne à 5 colonnes sur un écran large (chaque colonne ne dépasse jamais
     100%/5 de la largeur) tout en repassant sur un plancher de 200px pour se réorganiser en moins
     de colonnes sur un écran étroit — sans lui, auto-fill seul aurait pu aligner plus de 5
     pastilles sur une très large fenêtre. */
  .bp-chip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(max(200px, calc(20% - 0.8rem)), 1fr));
    gap: 1rem;
    padding-top: 1.8rem;
  }

  /* Même gotcha que documenté plus haut pour .bp-cart-group-header__toggle : `[hidden]` seul seul
     n'a pas la spécificité nécessaire face à `display: grid` posé juste au-dessus. */
  .bp-chip-grid[hidden] {
    display: none;
  }

  .bp-chip {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.12);
    border-radius: 0.7rem;
  }

  .bp-chip__swatch {
    display: block;
    width: 4rem;
    height: 4rem;
    border-radius: 0.5rem;
    object-fit: cover;
    box-shadow: 0 0 0 0.1rem rgba(var(--color-foreground), 0.1);
  }

  .bp-chip__body {
    flex: 1;
    min-width: 0;
  }

  /* Le prix repasse sur sa propre ligne sous le nom (plutôt qu'à côté, sur la même ligne) : lui
     laisser toute la largeur de la carte pour lui seul évite de rogner le nom en ellipse dès qu'un
     prix prenait de la place à côté. */
  .bp-chip__name {
    display: block;
    font-weight: 600;
    font-size: 1.3rem;
    text-decoration: none;
    color: inherit;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bp-chip__price {
    font-size: 1.15rem;
    opacity: 0.6;
    margin-top: 0.1rem;
  }

  .bp-chip__row2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.7rem;
  }

  /* Réduite au maximum de ce que permet <quantity-input> sans le réécrire : le composant du thème
     (voir global.js) garde son ombre/bordure décorative (pseudo-éléments :before/:after de
     .quantity, posés par base.css) — non retirée ici pour rester cohérente avec le reste du site,
     seules les dimensions sont resserrées. */
  .bp-chip .quantity {
    min-height: 2.6rem;
    width: 7.6rem;
  }

  .bp-chip .quantity__button {
    width: 2.2rem;
    font-size: 1.1rem;
  }

  .bp-chip .quantity__input {
    font-size: 1.2rem;
    padding: 0 0.1rem;
  }

  .bp-chip__total {
    font-size: 1.2rem;
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }

  /* icon-close-small.svg (une croix) plutôt que l'icône poubelle par défaut de cart-remove-button
     (voir bp-cart-chip.liquid) — bouton plus discret, cohérent avec la maquette validée. */
  .bp-chip__remove {
    padding: 0.4rem;
  }

  .bp-chip__remove .icon {
    width: 1rem;
    height: 1rem;
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<script>
  // Bouton "Retirer ces perles" d'un groupe de design (voir bp-cart-group-header__remove
  // ci-dessous) : retire en un seul appel toutes les lignes du groupe via /cart/update.js (par
  // clé de ligne, donc pas sensible aux décalages d'index qu'entraînerait un retrait ligne par
  // ligne). Volontairement indépendant du custom element CartItems du thème — un rechargement de
  // page après succès reste plus simple et fiable qu'un ré-rendu partiel, et c'est déjà le
  // comportement du lien "Vider le panier" juste au-dessus.
  document.addEventListener('click', function (event) {
    var btn = event.target.closest('.bp-cart-group-header__remove')
    if (!btn) return
    event.preventDefault()
    var keys = (btn.dataset.bpRemoveKeys || '').split(',').filter(Boolean)
    if (keys.length === 0) return
    var updates = {}
    keys.forEach(function (key) {
      updates[key] = 0
    })
    btn.disabled = true
    var originalLabel = btn.textContent
    btn.textContent = '…'
    fetch(window.routes.cart_update_url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ updates: updates }),
    })
      .then(function (res) {
        if (!res.ok) throw new Error('cart update failed')
        window.location.reload()
      })
      .catch(function () {
        btn.disabled = false
        btn.textContent = originalLabel
      })
  })

  // Bouton replier/déplier d'un groupe de design (voir bp-cart-group-header__toggle) : bascule
  // l'attribut `hidden` de la grille de pastilles (data-bp-group, posé replié par défaut côté
  // Liquid), purement côté client — aucune requête réseau, contrairement au retrait groupé.
  //
  // Changer la quantité ou retirer UNE couleur (bouton ✕ d'une pastille) passe par le custom
  // element CartItems du thème, qui remplace tout le contenu de #main-cart-items par du HTML
  // fraîchement rendu par Liquid après chaque appel réussi à /cart/change.js — et ce HTML rend
  // toujours chaque groupe replié par défaut. Sans ce qui suit, déplier un design puis changer une
  // quantité ou retirer une couleur à l'intérieur le refermait aussitôt. bpExpandedGroups retient
  // quels groupes (identifiés par le nom du design, stable d'un ré-rendu à l'autre — voir
  // bp_group_id) étaient dépliés, et un MutationObserver sur #main-cart-items les rouvre après
  // chaque remplacement.
  var bpExpandedGroups = {}

  function bpApplyExpandedGroups() {
    document.querySelectorAll('.bp-cart-group-header__toggle').forEach(function (toggle) {
      var expanded = !!bpExpandedGroups[toggle.dataset.bpToggle]
      toggle.setAttribute('aria-expanded', String(expanded))
    })
    document.querySelectorAll('.bp-chip-grid').forEach(function (grid) {
      grid.hidden = !bpExpandedGroups[grid.dataset.bpGroup]
    })
  }

  document.addEventListener('click', function (event) {
    var toggle = event.target.closest('.bp-cart-group-header__toggle')
    if (!toggle) return
    var groupId = toggle.dataset.bpToggle
    bpExpandedGroups[groupId] = !bpExpandedGroups[groupId]
    bpApplyExpandedGroups()
  })

  var bpMainCartItems = document.getElementById('main-cart-items')
  var bpJsContents = bpMainCartItems && bpMainCartItems.querySelector('.js-contents')
  if (bpJsContents) {
    new MutationObserver(bpApplyExpandedGroups).observe(bpJsContents, { childList: true })
  }
</script>

<cart-items
  class="gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}"
  view-event-payload="{{ cart | standard_event_data: 'view', context: 'page' | escape }}"
>
  <div class="page-width">
    <div class="title-wrapper-with-link">
      <h1 class="title title--primary">{{ 'sections.cart.title' | t }}</h1>
      <div class="bp-cart-title-links">
        {%- if cart != empty -%}
          <a href="{{ routes.cart_clear_url }}" class="underlined-link">Vider le panier</a>
        {%- endif -%}
        <a href="{{ routes.all_products_collection_url }}" class="underlined-link">
          {{- 'general.continue_shopping' | t -}}
        </a>
      </div>
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'general.continue_shopping' | t }}
      </a>

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            {%- comment -%}
              Regroupe les lignes du panier par design (propriété de ligne _bp_design posée à
              l'ajout, voir shopifyCart.js) : quand plusieurs designs sont commandés d'affilée,
              chacun a son en-tête + son bouton "Retirer ces perles" plutôt que de tout mélanger
              dans une liste plate où on ne sait plus quelles perles vont avec quel design.
              bp_group_list garde l'ordre de première apparition ; '||BP-SEP||' comme séparateur
              pour que `contains` ne matche jamais un nom de design partiellement (ex. "Chat" dans
              "Chat Noir") lors de la détection des doublons. Chaque groupe est une grille de
              pastilles (voir bp-cart-chip.liquid) plutôt qu'un tableau : les articles ajoutés hors
              configurateur (sans design associé) gardent eux la mise en page tableau standard du
              thème, dans un second temps plus bas — seulement s'il y en a.
            {%- endcomment -%}
            {%- liquid
              assign bp_group_keys = '||BP-SEP||'
              assign bp_has_orphans = false
              for item in cart.items
                assign bp_name = item.properties['_bp_design']
                if bp_name != blank
                  assign bp_needle = '||BP-SEP||' | append: bp_name | append: '||BP-SEP||'
                  unless bp_group_keys contains bp_needle
                    assign bp_group_keys = bp_group_keys | append: bp_name | append: '||BP-SEP||'
                  endunless
                else
                  assign bp_has_orphans = true
                endif
              endfor
              assign bp_group_list = bp_group_keys | split: '||BP-SEP||'
            -%}

            <div class="bp-cart-groups">
              {%- for bp_name in bp_group_list -%}
                {%- unless bp_name == blank -%}
                  {%- liquid
                    # Le nom du design sert d'identifiant de groupe (plutôt que forloop.index) :
                    # stable d'un ré-rendu à l'autre après un changement de quantité ou un retrait
                    # (cart.js remplace toute la section par du HTML fraîchement rendu), alors qu'un
                    # index de position se décale dès qu'un groupe disparaît ou change de place —
                    # voir le script plus bas qui s'appuie dessus pour restaurer les groupes dépliés
                    # après ce ré-rendu.
                    assign bp_group_id = bp_name | escape
                    assign bp_keys = ''
                    assign bp_line_count = 0
                    assign bp_qty_total = 0
                    assign bp_image = ''
                    for item in cart.items
                      if item.properties['_bp_design'] == bp_name
                        assign bp_keys = bp_keys | append: item.key | append: ','
                        assign bp_line_count = bp_line_count | plus: 1
                        assign bp_qty_total = bp_qty_total | plus: item.quantity
                        if bp_image == '' and item.properties['_bp_design_image'] != blank
                          assign bp_image = item.properties['_bp_design_image']
                        endif
                      endif
                    endfor
                  -%}
                  <div class="bp-cart-group">
                    <div class="bp-cart-group-header__row">
                      {%- comment -%}
                        Replié par défaut (voir le script plus haut) : avec plusieurs designs au
                        panier, la liste complète de toutes les couleurs de tous les designs
                        devenait très longue à parcourir — replier ne garde que l'essentiel visible
                        (miniature, nom, total) et un clic rouvre le détail d'un design à la fois.
                      {%- endcomment -%}
                      <button
                        type="button"
                        class="bp-cart-group-header__toggle"
                        data-bp-toggle="{{ bp_group_id }}"
                        aria-expanded="false"
                        aria-label="Afficher le détail des couleurs"
                      >
                        <span class="bp-cart-group-header__chevron" aria-hidden="true">▸</span>
                      </button>
                      {%- if bp_image != blank -%}
                        <img class="bp-cart-group-header__thumb" src="{{ bp_image }}" alt="" width="36" height="36">
                      {%- endif -%}
                      <span class="bp-cart-group-header__title">{{ bp_name | escape }}</span>
                      <span class="bp-cart-group-header__meta">
                        {{ bp_line_count }} couleur{% if bp_line_count > 1 %}s{% endif %} · {{ bp_qty_total }} sachet{% if bp_qty_total > 1 %}s{% endif %}
                      </span>
                      <button
                        type="button"
                        class="bp-cart-group-header__remove link"
                        data-bp-remove-keys="{{ bp_keys | strip_newlines }}"
                      >
                        Retirer ces perles
                      </button>
                    </div>
                    <div class="bp-chip-grid" data-bp-group="{{ bp_group_id }}" hidden>
                      {%- for item in cart.items -%}
                        {%- if item.properties['_bp_design'] == bp_name -%}
                          {%- render 'bp-cart-chip', item: item -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endunless -%}
              {%- endfor -%}
            </div>

            {%- comment -%}
              Articles sans design associé (produits ajoutés hors configurateur, ou anciennes
              lignes de panier créées avant ce regroupement) : mise en page tableau standard du
              thème, inchangée, à la suite des groupes — seulement si le panier en contient.
            {%- endcomment -%}
            {%- if bp_has_orphans -%}
              <table class="cart-items">
                <caption class="visually-hidden">
                  {{ 'sections.cart.title' | t }}
                </caption>
                <thead>
                  <tr>
                    <th class="caption-with-letter-spacing" colspan="2" scope="col">
                      {{ 'sections.cart.headings.product' | t }}
                    </th>
                    <th class="medium-hide large-up-hide right caption-with-letter-spacing" colspan="1" scope="col">
                      {{ 'sections.cart.headings.total' | t }}
                    </th>
                    <th
                      class="cart-items__heading--wide cart-items__heading--quantity small-hide caption-with-letter-spacing"
                      colspan="1"
                      scope="col"
                    >
                      {{ 'sections.cart.headings.quantity' | t }}
                    </th>
                    <th class="small-hide right caption-with-letter-spacing" colspan="1" scope="col">
                      {{ 'sections.cart.headings.total' | t }}
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {%- for item in cart.items -%}
                    {%- if item.properties['_bp_design'] == blank -%}
                      {%- render 'bp-cart-item-row', item: item -%}
                    {%- endif -%}
                  {%- endfor -%}
                </tbody>
              </table>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
