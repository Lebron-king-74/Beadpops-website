{% liquid
  assign starter_url = section.settings.starter_collection.url | default: routes.all_products_collection_url
  assign outils_url = section.settings.accessories_collection.url | default: routes.all_products_collection_url
  assign creator_url = section.settings.creator_page.url | default: '#'
  assign recharges_url = section.settings.recharges_page.url | default: '#'
  assign marketplace_url = creator_url | append: '#/marketplace'
  assign creator_editor_url = creator_url | append: '#/nouveau'
%}
{% comment %}
  Commit vide de resynchronisation : la connexion GitHub du thème avait perdu son accès au dépôt
  (permissions expirées côté app Shopify), donc plusieurs commits poussés sur main n'avaient
  jamais atteint le thème en ligne malgré un dépôt à jour — d'où l'icône panier mobile toujours
  masquée malgré le correctif ci-dessous. Permissions rétablies ; ce commit force une nouvelle
  synchro pour rattraper tout ce qui a été manqué.

  Le span #cart-icon-bubble (invisible, voir plus bas) n'est pas décoratif : le thème Dawn
  (assets/cart.js) s'attend à trouver un élément portant cet ID sur TOUTE page où le panier peut
  être modifié en Ajax (ex. changer une quantité sur /cart). Ce header custom remplace le header
  Dawn standard (voir sections/header.liquid), qui est le seul autre endroit où cet ID existe
  normalement — sans lui, la boucle de mise à jour des sections plante avant d'atteindre le total
  du panier (main-cart-footer), qui reste alors figé à l'ancien prix après un changement de
  quantité.
{% endcomment %}
<style>

@font-face{font-family:Silkscreen;src:url({{ 'bp-silkscreen-400.woff2' | asset_url }}) format('woff2');font-display:swap}
@font-face{font-family:'PressStart2P';src:url('https://beadpops-configurateur.vercel.app/fonts/PressStart2P-Regular.ttf') format('truetype');font-display:swap}
@font-face{font-family:Bricolage Grotesque;src:url({{ 'bp-bricolage-grotesque.woff2' | asset_url }}) format('woff2');font-weight:100 900;font-display:swap}
@font-face{font-family:Hanken Grotesk;src:url({{ 'bp-hanken-grotesk.woff2' | asset_url }}) format('woff2');font-weight:100 900;font-display:swap}
.bp-commerce{--void:#0C0B0B;--charcoal:#161412;--pearl:#F5EDE0;--sand:#C9A87C;--pop:#FF5C1A;color:var(--void);background:var(--pearl);font-family:Hanken Grotesk,sans-serif}
.bp-commerce *{box-sizing:border-box}.bp-commerce img,.bp-commerce video{display:block;max-width:100%}.bp-commerce a{color:inherit}.bp-wrap{width:min(calc(100% - 64px),1480px);margin-inline:auto}.bp-pixel{font-family:Silkscreen,monospace;letter-spacing:.08em;text-transform:uppercase}.bp-title{font-family:Bricolage Grotesque,sans-serif;font-weight:850;letter-spacing:-.045em}.bp-accent{color:var(--pop)}
@media(max-width:767px){.bp-wrap{width:min(calc(100% - 40px),1480px)}}

#bp-shop-header-{{ section.id }}{position:sticky;top:0;z-index:60;color:#F5EDE0;background:rgba(12,11,11,.97);border-bottom:1px solid rgba(245,237,224,.13);font-family:Hanken Grotesk,sans-serif;backdrop-filter:blur(14px)}
#bp-shop-header-{{ section.id }} *{box-sizing:border-box}.bp-shopbar{min-height:72px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:clamp(24px,4vw,64px)}.bp-shopbrand{color:#F5EDE0;font:400 16px/1 'PressStart2P',monospace;letter-spacing:.02em;text-decoration:none}.bp-shopbrand span{color:#FF5C1A}.bp-shopnav{justify-self:center;display:flex;align-items:center;gap:clamp(22px,3vw,42px)}.bp-shopnav a,.bp-shopnav button{position:relative;padding:28px 0;border:0;color:#F5EDE0;background:transparent;font:700 14px/1 Hanken Grotesk,sans-serif;text-decoration:none;cursor:pointer}.bp-shopnav a:after,.bp-shopnav button:after{content:"";position:absolute;right:0;bottom:18px;left:0;height:2px;background:#FF5C1A;transform:scaleX(0);transform-origin:left;transition:transform .22s ease}.bp-shopnav a:hover:after,.bp-shopnav a:focus-visible:after,.bp-shopnav button:hover:after,.bp-shopnav button:focus-visible:after,.bp-shopnav button[aria-expanded=true]:after{transform:scaleX(1)}.bp-shopactions{display:flex;align-items:center;gap:10px}.bp-shopicon,.bp-shoptoggle{position:relative;width:42px;height:42px;display:grid;place-items:center;border:0;color:#F5EDE0;background:transparent;cursor:pointer}.bp-shopicon svg,.bp-shoptoggle svg{width:22px}.bp-shoptoggle{display:none}.bp-cartcount{display:none;position:absolute;top:4px;right:4px;min-width:16px;height:16px;padding:0 4px;align-items:center;justify-content:center;background:#FF5C1A;color:#0C0B0B;font:800 10px/1 Bricolage Grotesque,sans-serif;border-radius:999px}.bp-shopmega{position:absolute;top:100%;right:0;left:0;visibility:hidden;opacity:0;transform:translateY(-8px);pointer-events:none;background:#161412;border-bottom:1px solid rgba(245,237,224,.13);box-shadow:0 24px 54px rgba(12,11,11,.34);transition:opacity .2s ease,transform .24s ease,visibility .2s}.bp-shopmega.is-open{visibility:visible;opacity:1;transform:none;pointer-events:auto}.bp-shopmega__inner{padding-block:26px 32px}.bp-shopmega__top{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:18px}.bp-shopmega__eyebrow{margin:0 0 5px;color:#FF5C1A;font:400 10px/1.3 Silkscreen,monospace;letter-spacing:.08em;text-transform:uppercase}.bp-shopmega__title{margin:0;color:#F5EDE0;font:800 28px/1 Bricolage Grotesque,sans-serif}.bp-shopmega__all{color:#F5EDE0;font-weight:750;text-underline-offset:5px}.bp-shopcards{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}.bp-shopcard{position:relative;min-height:150px;overflow:hidden;color:#F5EDE0;background:#0C0B0B;text-decoration:none;isolation:isolate}.bp-shopcard img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .45s cubic-bezier(.16,1,.3,1)}.bp-shopcard:after{content:"";position:absolute;inset:35% 0 0;z-index:1;background:linear-gradient(transparent,rgba(12,11,11,.91))}.bp-shopcard span{position:absolute;z-index:2;right:14px;bottom:12px;left:14px;display:flex;justify-content:space-between;font:800 17px/1.05 Bricolage Grotesque,sans-serif}.bp-shopcard span:after{content:"→";color:#FF5C1A}.bp-shopcard:hover img,.bp-shopcard:focus-visible img{transform:scale(1.055)}.bp-shopdrawer{position:fixed;inset:64px 0 0;z-index:59;display:none;overflow:auto;padding:26px 20px 40px;color:#F5EDE0;background:#0C0B0B}.bp-shopdrawer.is-open{display:block}.bp-shopdrawer__primary{display:grid;margin-bottom:26px}.bp-shopdrawer__primary a{min-height:56px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(245,237,224,.13);color:#F5EDE0;font:800 22px/1.1 Bricolage Grotesque,sans-serif;text-decoration:none}.bp-shopdrawer__primary a:after{content:"→";color:#FF5C1A}.bp-shopdrawer__label{margin:0 0 12px;color:#FF5C1A;font:400 10px/1.3 Silkscreen,monospace;letter-spacing:.08em;text-transform:uppercase}.bp-shopdrawer__grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.bp-shopdrawer__grid .bp-shopcard{min-height:118px}
@media(max-width:900px){.bp-shopbar{min-height:64px;grid-template-columns:auto 1fr auto;gap:12px}.bp-shopnav{display:none}.bp-shopactions{justify-self:end}.bp-shoptoggle{display:grid}}
.bp-shopdesigns{position:relative}.bp-shopdesigns__panel{position:absolute;top:100%;left:50%;min-width:200px;visibility:hidden;opacity:0;transform:translateX(-50%) translateY(-8px);pointer-events:none;background:#161412;border:1px solid rgba(245,237,224,.13);box-shadow:0 24px 54px rgba(12,11,11,.34);transition:opacity .2s ease,transform .24s ease,visibility .2s;padding:8px}.bp-shopdesigns__panel.is-open{visibility:visible;opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto}.bp-shopdesigns__panel a{position:relative;display:block;padding:12px 14px;color:#F5EDE0;font:700 14px/1 Hanken Grotesk,sans-serif;text-decoration:none;white-space:nowrap}.bp-shopdesigns__panel a:after{display:none}.bp-shopdesigns__panel a:hover{background:rgba(245,237,224,.08)}
</style>
<header id="bp-shop-header-{{ section.id }}" data-bp-shop-header>
  <div class="bp-shopbar bp-wrap">
    <a class="bp-shopbrand" href="{{ routes.root_url }}" aria-label="BeadPops, accueil">BEAD<span>POPS</span></a>
    <nav class="bp-shopnav" aria-label="Navigation principale"><a href="{{ starter_url }}">Starter Kit</a><a href="{{ recharges_url }}">Recharges de perles</a><a href="{{ outils_url }}">Outils</a><div class="bp-shopdesigns"><button type="button" data-bp-designs-trigger aria-expanded="false">Designs</button><div class="bp-shopdesigns__panel" data-bp-designs-panel aria-hidden="true"><a href="{{ creator_editor_url }}">Créer un design</a><a href="{{ marketplace_url }}">Trouver un design</a></div></div></nav>
    <div class="bp-shopactions"><a class="bp-shopicon" href="{{ routes.cart_url }}" aria-label="Panier"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg><span class="bp-cartcount" data-bp-cart-count>0</span></a><span id="cart-icon-bubble" class="visually-hidden" aria-hidden="true"></span><button class="bp-shoptoggle" type="button" data-bp-drawer-trigger aria-label="Ouvrir le menu" aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button></div>
  </div>
</header>
<nav class="bp-shopdrawer" data-bp-drawer aria-hidden="true" aria-label="Navigation mobile"><div class="bp-shopdrawer__primary"><a href="{{ starter_url }}">Starter Kit</a><a href="{{ recharges_url }}">Recharges de perles</a><a href="{{ outils_url }}">Outils</a><a href="{{ creator_editor_url }}">Créer un design</a><a href="{{ marketplace_url }}">Trouver un design</a></div></nav>
<script>(function(){const root=document.querySelector('#bp-shop-header-{{ section.id }}');if(!root)return;const panel=root.querySelector('[data-bp-designs-panel]'),trigger=root.querySelector('[data-bp-designs-trigger]'),drawer=document.querySelector('[data-bp-drawer]'),toggle=root.querySelector('[data-bp-drawer-trigger]');function closePanel(){panel.classList.remove('is-open');panel.setAttribute('aria-hidden','true');trigger.setAttribute('aria-expanded','false')}trigger.addEventListener('click',()=>{const open=!panel.classList.contains('is-open');closePanel();if(open){panel.classList.add('is-open');panel.setAttribute('aria-hidden','false');trigger.setAttribute('aria-expanded','true')}});toggle.addEventListener('click',()=>{const open=!drawer.classList.contains('is-open');drawer.classList.toggle('is-open',open);drawer.setAttribute('aria-hidden',String(!open));toggle.setAttribute('aria-expanded',String(open));document.body.style.overflow=open?'hidden':''});document.addEventListener('click',e=>{if(!root.contains(e.target))closePanel()});const cartCountEl=root.querySelector('[data-bp-cart-count]');function updateCartCount(n){if(!cartCountEl)return;cartCountEl.textContent=n>99?'99+':n;cartCountEl.style.display=n>0?'flex':'none'}fetch('/cart.js').then(r=>r.json()).then(c=>updateCartCount(c.item_count)).catch(()=>{});window.addEventListener('beadpops:cart-updated',e=>updateCartCount(e.detail.count));})();</script>
{% schema %}
{"name":"Menu BeadPops","class":"section-header","settings":[{"type":"page","id":"creator_page","label":"Page Créateur"},{"type":"page","id":"recharges_page","label":"Page Recharges de perles"},{"type":"collection","id":"all_collection","label":"Tous les designs (inutilisé)"},{"type":"collection","id":"starter_collection","label":"Starter Kit"},{"type":"collection","id":"accessories_collection","label":"Outils"}],"blocks":[{"type":"card","name":"Carte visuelle","settings":[{"type":"text","id":"label","label":"Nom","default":"Kawaii"},{"type":"collection","id":"collection","label":"Collection"},{"type":"url","id":"link","label":"Lien de secours"},{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"fallback_asset","label":"Visuel par défaut","default":"bp-menu-kawaii.webp","options":[{"value":"bp-menu-kawaii.webp","label":"Kawaii"},{"value":"bp-menu-fantasy.webp","label":"Fantasy"},{"value":"bp-menu-anime.webp","label":"Anime"},{"value":"bp-menu-cartoons.webp","label":"Cartoons"},{"value":"bp-commerce-starter-kit.webp","label":"Starter Kit"},{"value":"bp-commerce-accessories.webp","label":"Accessoires"}]}]}],"max_blocks":6,"presets":[{"name":"Menu BeadPops","blocks":[{"type":"card","settings":{"label":"Kawaii","fallback_asset":"bp-menu-kawaii.webp"}},{"type":"card","settings":{"label":"Fantasy","fallback_asset":"bp-menu-fantasy.webp"}},{"type":"card","settings":{"label":"Anime","fallback_asset":"bp-menu-anime.webp"}},{"type":"card","settings":{"label":"Cartoons","fallback_asset":"bp-menu-cartoons.webp"}},{"type":"card","settings":{"label":"Starter Kits","fallback_asset":"bp-commerce-starter-kit.webp"}},{"type":"card","settings":{"label":"Accessoires","fallback_asset":"bp-commerce-accessories.webp"}}]}]}
{% endschema %}