{% liquid
  assign all_url = section.settings.all_collection.url | default: routes.all_products_collection_url
  assign starter_url = section.settings.starter_collection.url | default: routes.all_products_collection_url
  assign accessories_url = section.settings.accessories_collection.url | default: routes.all_products_collection_url
  assign creator_url = section.settings.creator_page.url | default: '#'
  assign marketplace_url = creator_url | append: '#/marketplace'
%}
<style>

@font-face{font-family:Silkscreen;src:url({{ 'bp-silkscreen-400.woff2' | asset_url }}) format('woff2');font-display:swap}
@font-face{font-family:Bricolage Grotesque;src:url({{ 'bp-bricolage-grotesque.woff2' | asset_url }}) format('woff2');font-weight:100 900;font-display:swap}
@font-face{font-family:Hanken Grotesk;src:url({{ 'bp-hanken-grotesk.woff2' | asset_url }}) format('woff2');font-weight:100 900;font-display:swap}
.bp-commerce{--void:#0C0B0B;--charcoal:#161412;--pearl:#F5EDE0;--sand:#C9A87C;--pop:#FF5C1A;color:var(--void);background:var(--pearl);font-family:Hanken Grotesk,sans-serif}
.bp-commerce *{box-sizing:border-box}.bp-commerce img,.bp-commerce video{display:block;max-width:100%}.bp-commerce a{color:inherit}.bp-wrap{width:min(calc(100% - 64px),1480px);margin-inline:auto}.bp-pixel{font-family:Silkscreen,monospace;letter-spacing:.08em;text-transform:uppercase}.bp-title{font-family:Bricolage Grotesque,sans-serif;font-weight:850;letter-spacing:-.045em}.bp-accent{color:var(--pop)}
@media(max-width:767px){.bp-wrap{width:min(calc(100% - 40px),1480px)}}

#bp-shop-header-{{ section.id }}{position:sticky;top:0;z-index:60;color:#F5EDE0;background:rgba(12,11,11,.97);border-bottom:1px solid rgba(245,237,224,.13);font-family:Hanken Grotesk,sans-serif;backdrop-filter:blur(14px)}
#bp-shop-header-{{ section.id }} *{box-sizing:border-box}.bp-shopbar{min-height:72px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:clamp(24px,4vw,64px)}.bp-shopbrand{color:#F5EDE0;font:400 18px/1 Silkscreen,monospace;letter-spacing:.06em;text-decoration:none}.bp-shopbrand span{color:#FF5C1A}.bp-shopnav{justify-self:center;display:flex;align-items:center;gap:clamp(22px,3vw,42px)}.bp-shopnav a,.bp-shopnav button{position:relative;padding:28px 0;border:0;color:#F5EDE0;background:transparent;font:700 14px/1 Hanken Grotesk,sans-serif;text-decoration:none;cursor:pointer}.bp-shopnav a:after,.bp-shopnav button:after{content:"";position:absolute;right:0;bottom:18px;left:0;height:2px;background:#FF5C1A;transform:scaleX(0);transform-origin:left;transition:transform .22s ease}.bp-shopnav a:hover:after,.bp-shopnav a:focus-visible:after,.bp-shopnav button:hover:after,.bp-shopnav button:focus-visible:after,.bp-shopnav button[aria-expanded=true]:after{transform:scaleX(1)}.bp-shopactions{display:flex;align-items:center;gap:10px}.bp-shopcta{min-height:42px;display:inline-flex;align-items:center;padding:0 18px;color:#0C0B0B;background:#FF5C1A;font:800 14px/1 Bricolage Grotesque,sans-serif;text-decoration:none;clip-path:polygon(0 0,calc(100% - 8px) 0,calc(100% - 8px) 4px,100% 4px,100% 100%,8px 100%,8px calc(100% - 4px),0 calc(100% - 4px))}.bp-shopicon,.bp-shoptoggle{width:42px;height:42px;display:grid;place-items:center;border:0;color:#F5EDE0;background:transparent;cursor:pointer}.bp-shopicon svg,.bp-shoptoggle svg{width:22px}.bp-shoptoggle{display:none}.bp-shopmega{position:absolute;top:100%;right:0;left:0;visibility:hidden;opacity:0;transform:translateY(-8px);pointer-events:none;background:#161412;border-bottom:1px solid rgba(245,237,224,.13);box-shadow:0 24px 54px rgba(12,11,11,.34);transition:opacity .2s ease,transform .24s ease,visibility .2s}.bp-shopmega.is-open{visibility:visible;opacity:1;transform:none;pointer-events:auto}.bp-shopmega__inner{padding-block:26px 32px}.bp-shopmega__top{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:18px}.bp-shopmega__eyebrow{margin:0 0 5px;color:#FF5C1A;font:400 10px/1.3 Silkscreen,monospace;letter-spacing:.08em;text-transform:uppercase}.bp-shopmega__title{margin:0;color:#F5EDE0;font:800 28px/1 Bricolage Grotesque,sans-serif}.bp-shopmega__all{color:#F5EDE0;font-weight:750;text-underline-offset:5px}.bp-shopcards{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}.bp-shopcard{position:relative;min-height:150px;overflow:hidden;color:#F5EDE0;background:#0C0B0B;text-decoration:none;isolation:isolate}.bp-shopcard img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .45s cubic-bezier(.16,1,.3,1)}.bp-shopcard:after{content:"";position:absolute;inset:35% 0 0;z-index:1;background:linear-gradient(transparent,rgba(12,11,11,.91))}.bp-shopcard span{position:absolute;z-index:2;right:14px;bottom:12px;left:14px;display:flex;justify-content:space-between;font:800 17px/1.05 Bricolage Grotesque,sans-serif}.bp-shopcard span:after{content:"→";color:#FF5C1A}.bp-shopcard:hover img,.bp-shopcard:focus-visible img{transform:scale(1.055)}.bp-shopdrawer{position:fixed;inset:64px 0 0;z-index:59;display:none;overflow:auto;padding:26px 20px 40px;color:#F5EDE0;background:#0C0B0B}.bp-shopdrawer.is-open{display:block}.bp-shopdrawer__primary{display:grid;margin-bottom:26px}.bp-shopdrawer__primary a{min-height:56px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(245,237,224,.13);color:#F5EDE0;font:800 22px/1.1 Bricolage Grotesque,sans-serif;text-decoration:none}.bp-shopdrawer__primary a:after{content:"→";color:#FF5C1A}.bp-shopdrawer__label{margin:0 0 12px;color:#FF5C1A;font:400 10px/1.3 Silkscreen,monospace;letter-spacing:.08em;text-transform:uppercase}.bp-shopdrawer__grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.bp-shopdrawer__grid .bp-shopcard{min-height:118px}
@media(max-width:900px){.bp-shopbar{min-height:64px;grid-template-columns:auto 1fr auto;gap:12px}.bp-shopnav,.bp-shopcta,.bp-shopicon{display:none}.bp-shopactions{justify-self:end}.bp-shoptoggle{display:grid}}
</style>
<header id="bp-shop-header-{{ section.id }}" data-bp-shop-header>
  <div class="bp-shopbar bp-wrap">
    <a class="bp-shopbrand" href="{{ routes.root_url }}" aria-label="BeadPops, accueil">BEAD<span>POPS</span></a>
    <nav class="bp-shopnav" aria-label="Navigation principale"><a href="{{ creator_url }}">Créer mon design</a><a href="{{ marketplace_url }}">Tous les designs</a><button type="button" data-bp-mega-trigger aria-expanded="false">Univers</button><a href="{{ starter_url }}">Starter Kits</a><a href="{{ accessories_url }}">Accessoires</a></nav>
    <div class="bp-shopactions"><a class="bp-shopcta" href="{{ all_url }}">Voir les designs</a><a class="bp-shopicon" href="{{ routes.cart_url }}" aria-label="Panier"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg></a><button class="bp-shoptoggle" type="button" data-bp-drawer-trigger aria-label="Ouvrir le menu" aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button></div>
  </div>
  <div class="bp-shopmega" data-bp-mega aria-hidden="true"><div class="bp-shopmega__inner bp-wrap"><div class="bp-shopmega__top"><div><p class="bp-shopmega__eyebrow">Explorer la boutique</p><p class="bp-shopmega__title">Choisis ton univers</p></div><a class="bp-shopmega__all" href="{{ all_url }}">Voir tout le catalogue</a></div><div class="bp-shopcards">
    {% for block in section.blocks %}{% liquid assign card_url = block.settings.collection.url | default: block.settings.link | default: all_url %}<a class="bp-shopcard" href="{{ card_url }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '240,360,480,640', alt: '' }}{% else %}<img src="{{ block.settings.fallback_asset | asset_url }}" alt="" width="640" height="480" loading="lazy">{% endif %}<span>{{ block.settings.label | escape }}</span></a>{% endfor %}
  </div></div></div>
</header>
<nav class="bp-shopdrawer" data-bp-drawer aria-hidden="true" aria-label="Navigation mobile"><div class="bp-shopdrawer__primary"><a href="{{ creator_url }}">Créer mon design</a><a href="{{ marketplace_url }}">Tous les designs</a><a href="{{ starter_url }}">Starter Kits</a><a href="{{ accessories_url }}">Accessoires</a></div><p class="bp-shopdrawer__label">Choisir un univers</p><div class="bp-shopdrawer__grid">{% for block in section.blocks limit: 4 %}{% liquid assign card_url = block.settings.collection.url | default: block.settings.link | default: all_url %}<a class="bp-shopcard" href="{{ card_url }}">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240,360,480', alt: '' }}{% else %}<img src="{{ block.settings.fallback_asset | asset_url }}" alt="" width="480" height="360" loading="lazy">{% endif %}<span>{{ block.settings.label | escape }}</span></a>{% endfor %}</div></nav>
<script>(function(){const root=document.querySelector('#bp-shop-header-{{ section.id }}');if(!root)return;const mega=root.querySelector('[data-bp-mega]'),trigger=root.querySelector('[data-bp-mega-trigger]'),drawer=document.querySelector('[data-bp-drawer]'),toggle=root.querySelector('[data-bp-drawer-trigger]');function closeMega(){mega.classList.remove('is-open');mega.setAttribute('aria-hidden','true');trigger.setAttribute('aria-expanded','false')}trigger.addEventListener('click',()=>{const open=!mega.classList.contains('is-open');closeMega();if(open){mega.classList.add('is-open');mega.setAttribute('aria-hidden','false');trigger.setAttribute('aria-expanded','true')}});toggle.addEventListener('click',()=>{const open=!drawer.classList.contains('is-open');drawer.classList.toggle('is-open',open);drawer.setAttribute('aria-hidden',String(!open));toggle.setAttribute('aria-expanded',String(open));document.body.style.overflow=open?'hidden':''});document.addEventListener('click',e=>{if(!root.contains(e.target))closeMega()});})();</script>
{% schema %}
{"name":"Menu BeadPops","class":"section-header","settings":[{"type":"page","id":"creator_page","label":"Page Créateur"},{"type":"collection","id":"all_collection","label":"Tous les designs"},{"type":"collection","id":"starter_collection","label":"Starter Kits"},{"type":"collection","id":"accessories_collection","label":"Accessoires"}],"blocks":[{"type":"card","name":"Carte visuelle","settings":[{"type":"text","id":"label","label":"Nom","default":"Kawaii"},{"type":"collection","id":"collection","label":"Collection"},{"type":"url","id":"link","label":"Lien de secours"},{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"fallback_asset","label":"Visuel par défaut","default":"bp-menu-kawaii.webp","options":[{"value":"bp-menu-kawaii.webp","label":"Kawaii"},{"value":"bp-menu-fantasy.webp","label":"Fantasy"},{"value":"bp-menu-anime.webp","label":"Anime"},{"value":"bp-menu-cartoons.webp","label":"Cartoons"},{"value":"bp-commerce-starter-kit.webp","label":"Starter Kit"},{"value":"bp-commerce-accessories.webp","label":"Accessoires"}]}]}],"max_blocks":6,"presets":[{"name":"Menu BeadPops","blocks":[{"type":"card","settings":{"label":"Kawaii","fallback_asset":"bp-menu-kawaii.webp"}},{"type":"card","settings":{"label":"Fantasy","fallback_asset":"bp-menu-fantasy.webp"}},{"type":"card","settings":{"label":"Anime","fallback_asset":"bp-menu-anime.webp"}},{"type":"card","settings":{"label":"Cartoons","fallback_asset":"bp-menu-cartoons.webp"}},{"type":"card","settings":{"label":"Starter Kits","fallback_asset":"bp-commerce-starter-kit.webp"}},{"type":"card","settings":{"label":"Accessoires","fallback_asset":"bp-commerce-accessories.webp"}}]}]}
{% endschema %}