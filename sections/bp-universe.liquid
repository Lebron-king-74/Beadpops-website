<section id="bp-universe" data-price-placeholders="true" data-time-placeholders="true">
  <div class="uv-wrap lp-wrap">
    <div class="uv-head"><p class="uv-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="uv-title">{{ section.settings.title | escape }} <span class="os-accent">{{ section.settings.title_accent | escape }}</span></h2></div>
