            <div class="uv-track">
              <a class="uv-cover" href="{{ section.settings.kawaii_collection.url | default: '#bp-universe' }}"><img loading="lazy" decoding="async" width="720" height="960" src="{{ 'bp-univers-catalog-kawaii-cover.webp' | asset_url }}" alt="Sélection de modèles pixel art kawaii"><span class="uv-cover-lbl"><span class="uv-cover-kick">Univers</span><span class="uv-cover-name">Kawaii</span><span class="uv-cover-go">Voir la collection <span aria-hidden="true">&rarr;</span></span></span></a>
              <div class="uv-card"><div class="uv-media"><span class="uv-badge">Facile</span><button class="uv-heart" type="button" aria-label="Ajouter Cœur sucré aux favoris" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.7-10-9.3C.4 8.5 2 5 5.5 5c2 0 3.4 1.2 4.5 2.6C11.1 6.2 12.5 5 14.5 5 18 5 19.6 8.5 22 11.7 19.5 16.3 12 21 12 21z"/></svg></button><a class="uv-media-link" href="#" aria-label="Cœur sucré"></a></div><p class="uv-pname">Cœur sucré</p><p class="uv-price">14,99 €</p></div>
              <div class="uv-card"><div class="uv-media"><span class="uv-badge">Facile</span><button class="uv-heart" type="button" aria-label="Ajouter Nuage rieur aux favoris" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.7-10-9.3C.4 8.5 2 5 5.5 5c2 0 3.4 1.2 4.5 2.6C11.1 6.2 12.5 5 14.5 5 18 5 19.6 8.5 22 11.7 19.5 16.3 12 21 12 21z"/></svg></button><a class="uv-media-link" href="#" aria-label="Nuage rieur"></a></div><p class="uv-pname">Nuage rieur</p><p class="uv-price">14,99 €</p></div>
              <div class="uv-card"><div class="uv-media"><span class="uv-badge">Medium</span><button class="uv-heart" type="button" aria-label="Ajouter Fraise mochi aux favoris" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.7-10-9.3C.4 8.5 2 5 5.5 5c2 0 3.4 1.2 4.5 2.6C11.1 6.2 12.5 5 14.5 5 18 5 19.6 8.5 22 11.7 19.5 16.3 12 21 12 21z"/></svg></button><a class="uv-media-link" href="#" aria-label="Fraise mochi"></a></div><p class="uv-pname">Fraise mochi</p><p class="uv-price">19,99 €</p></div>
              <div class="uv-card"><div class="uv-media"><span class="uv-badge">Medium</span><button class="uv-heart" type="button" aria-label="Ajouter Panda boba aux favoris" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.7-10-9.3C.4 8.5 2 5 5.5 5c2 0 3.4 1.2 4.5 2.6C11.1 6.2 12.5 5 14.5 5 18 5 19.6 8.5 22 11.7 19.5 16.3 12 21 12 21z"/></svg></button><a class="uv-media-link" href="#" aria-label="Panda boba"></a></div><p class="uv-pname">Panda boba</p><p class="uv-price">19,99 €</p></div>
