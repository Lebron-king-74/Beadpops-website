      <button class="uv-tab" role="tab" id="uvt-kawaii" aria-controls="uvp-kawaii" aria-selected="true" style="--acc:#FF6B9D"><span class="uv-tab-dot" aria-hidden="true"></span>Kawaii</button>
      <button class="uv-tab" role="tab" id="uvt-anime" aria-controls="uvp-anime" aria-selected="false" tabindex="-1" style="--acc:#67E8F9"><span class="uv-tab-dot" aria-hidden="true"></span>Anime &amp; Manga</button>
      <button class="uv-tab" role="tab" id="uvt-fantasy" aria-controls="uvp-fantasy" aria-selected="false" tabindex="-1" style="--acc:#C084FC"><span class="uv-tab-dot" aria-hidden="true"></span>Fantasy</button>
      <button class="uv-tab" role="tab" id="uvt-cartoons" aria-controls="uvp-cartoons" aria-selected="false" tabindex="-1" style="--acc:#FBBF24"><span class="uv-tab-dot" aria-hidden="true"></span>Cartoons</button>
    </div>
    <p class="uv-swipe-hint">Glisse pour voir l'univers et ses produits</p>

