{% schema %}
{
  "name": "BeadPops Univers",
  "tag": "section",
  "class": "beadpops-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Choisis ton univers"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Quel style te donne envie de"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Titre accentué",
      "default": "commencer ?"
    },
    {
      "type": "collection",
      "id": "kawaii_collection",
      "label": "Collection kawaii"
    },
    {
      "type": "collection",
      "id": "anime_collection",
      "label": "Collection anime"
    },
    {
      "type": "collection",
      "id": "fantasy_collection",
      "label": "Collection fantasy"
    },
    {
      "type": "collection",
      "id": "cartoons_collection",
      "label": "Collection cartoons"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "BeadPops Univers"
    }
  ]
}
{% endschema %}
